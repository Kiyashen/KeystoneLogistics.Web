@{
    ViewBag.Title = "Home";
}
@model KeystoneLogistics.Models.DashboardViewModel
<style>
    .hero-wrapper {
        position: relative;
        width: 100%;
        height: 1280vh;
        background: #0f172a;
    }

    #canvas-container {
        position: sticky;
        top: 0;
        width: 100%;
        height: 100vh;
        overflow: hidden;
        background: #0f172a;
    }

        #canvas-container canvas {
            display: block;
            width: 100%;
            height: 100%;
        }

    #loading-screen {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: #e2e8f0;
        font-family: 'Segoe UI', sans-serif;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: 1.5px;
        z-index: 10;
    }

    .card-overlay {
        position: fixed;
        top: 45%;
        width: 410px;
        padding: 30px;
        background: rgba(15, 23, 42, 0.78);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 20px;
        color: #ffffff;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0.6s ease;
        z-index: 5;
    }

    .card-left {
        left: 5%;
        transform: translateY(-50%) translateX(-140px) scale(0.6) rotateY(30deg);
    }

        .card-left.active {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateY(-50%) translateX(0) scale(1);
            animation: floatAnim 4s ease-in-out 0.8s infinite alternate;
        }

    .card-right {
        right: 5%;
        transform: translateY(-50%) translateX(140px) scale(0.6) rotateY(-30deg);
    }

        .card-right.active {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateY(-50%) translateX(0) scale(1);
            animation: floatAnim 4s ease-in-out 0.8s infinite alternate;
        }

    .card-center {
        left: 6%;
        width: 360px;
        transform: translateY(-50%) translateX(-80px) scale(0.92);
    }

        .card-center.active {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateY(-50%) translateX(0) scale(1);
        }

    .card-finale {
        left: 50%;
        width: 460px;
        transform: translate(-50%, -50%) scale(0.92);
    }

        .card-finale.active {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translate(-50%, -50%) scale(1);
        }

    .card-overlay::before {
        content: '';
        position: absolute;
        top: 0;
        left: 10%;
        right: 10%;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(56, 189, 248, 0.6), transparent);
    }

    .card-header-flex {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .card-badge {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(30, 41, 59, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .card-tag {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.1);
        padding: 5px 12px;
        border-radius: 6px;
        border: 1px solid rgba(56, 189, 248, 0.2);
    }

    .card-title {
        font-size: 24px;
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 8px;
    }

    .card-desc {
        font-size: 13.5px;
        color: #94a3b8;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .spec-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 16px;
    }

    .spec-item {
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.06);
        padding: 10px 14px;
        border-radius: 10px;
    }

    .spec-label {
        font-size: 11px;
        color: #64748b;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .spec-value {
        font-size: 15px;
        font-weight: 700;
        color: #f8fafc;
    }

        .spec-value.highlight {
            color: #38bdf8;
        }

    .scroll-nav {
        position: fixed;
        right: 25px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        flex-direction: column;
        gap: 14px;
        z-index: 10;
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

        .dot.active {
            height: 28px;
            border-radius: 10px;
            background: #38bdf8;
        }

    @@keyframes floatAnim {
        0% {
            transform: translateY(-50%);
        }

        100% {
            transform: translateY(calc(-50% - 10px));
        }
    }

    .reviews-marquee-container {
        overflow: hidden;
        width: 100%;
        display: flex;
        mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
        -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }

    .reviews-track {
        display: flex;
        gap: 24px;
        width: max-content;
        animation: scrollMarquee 35s linear infinite;
    }

        .reviews-track:hover {
            animation-play-state: paused;
        }

    .review-card-wrapper {
        width: 380px;
        flex-shrink: 0;
    }

    @@keyframes scrollMarquee {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(-50%);
        }
    }
</style>
<div class="hero-wrapper" id="scroll-wrapper">
    <div id="canvas-container">
        <div id="loading-screen">LOADING SHOWROOM...</div>
        <div class="scroll-nav" id="scroll-nav">
            <div class="dot active"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div>
        </div>
        <div class="card-overlay card-left" id="card-1">
            <div class="card-header-flex"><div class="card-badge">🚚</div><div class="card-tag">FLEET METRICS</div></div>
            <div class="card-title">Express Logistics Fleet</div>
            <div class="card-desc">High-capacity cargo vehicles engineered for optimal payload distribution and rapid regional delivery.</div>
            <div class="spec-grid">
                <div class="spec-item"><div class="spec-label">Max Payload</div><div class="spec-value highlight">1.8 Tons</div></div>
                <div class="spec-item"><div class="spec-label">Range</div><div class="spec-value">850 km</div></div>
                <div class="spec-item"><div class="spec-label">Service Type</div><div class="spec-value">Express 1:1</div></div>
                <div class="spec-item"><div class="spec-label">Dispatch Time</div><div class="spec-value highlight">&lt; 30 Mins</div></div>
            </div>
        </div>
        <div class="card-overlay card-right" id="card-2">
            <div class="card-header-flex"><div class="card-badge">📡</div><div class="card-tag">TELEMATICS CORE</div></div>
            <div class="card-title">Live Telematics System</div>
            <div class="card-desc">Real-time satellite tracking, automated dispatch updates, and smart driver route optimization delivered live.</div>
            <div class="spec-grid">
                <div class="spec-item"><div class="spec-label">Ping Latency</div><div class="spec-value highlight">&lt; 50 ms</div></div>
                <div class="spec-item"><div class="spec-label">GPS Precision</div><div class="spec-value">0.5 Meters</div></div>
                <div class="spec-item"><div class="spec-label">System Uptime</div><div class="spec-value">99.99%</div></div>
                <div class="spec-item"><div class="spec-label">AI Dispatch</div><div class="spec-value highlight">Active</div></div>
            </div>
        </div>
        <div class="card-overlay card-left" id="card-3">
            <div class="card-header-flex"><div class="card-badge">🛡️</div><div class="card-tag">CARGO PROTECTION</div></div>
            <div class="card-title">Secure Goods Vault</div>
            <div class="card-desc">Climate-stabilized interior compartments with dual biometric locks and real-time vault status tracking.</div>
            <div class="spec-grid">
                <div class="spec-item"><div class="spec-label">Temp Control</div><div class="spec-value highlight">-20°C to +15°C</div></div>
                <div class="spec-item"><div class="spec-label">Lock System</div><div class="spec-value">RFID / Bio</div></div>
                <div class="spec-item"><div class="spec-label">Security Tier</div><div class="spec-value">Grade AAA</div></div>
                <div class="spec-item"><div class="spec-label">Incident Rate</div><div class="spec-value highlight">0.00%</div></div>
            </div>
        </div>
        <div class="card-overlay card-center" id="cargo-card">
            <div class="card-header-flex"><div class="card-badge">📦</div><div class="card-tag">STORAGE YARD</div></div>
            <div class="card-title">Cargo staged for dispatch</div>
            <div class="card-desc">Packed freight waits on the shelf until the driver collects it. One yard. One handover. No loose parcels.</div>
            <div class="spec-grid">
                <div class="spec-item"><div class="spec-label">Hold</div><div class="spec-value highlight">Bay 04</div></div>
                <div class="spec-item"><div class="spec-label">Status</div><div class="spec-value">Ready</div></div>
            </div>
        </div>
        <div class="card-overlay card-center" id="driver-card">
            <div class="card-header-flex"><div class="card-badge">🧍</div><div class="card-tag">ON SITE</div></div>
            <div class="card-title">Driver at the door</div>
            <div class="card-desc">Parcel in hand. Collection PIN checked. The van returns once the handover is complete.</div>
            <div class="spec-grid">
                <div class="spec-item"><div class="spec-label">Check</div><div class="spec-value highlight">PIN verified</div></div>
                <div class="spec-item"><div class="spec-label">Next</div><div class="spec-value">Van return</div></div>
            </div>
        </div>
        <div class="card-overlay card-center" id="delivery-card">
            <div class="card-header-flex"><div class="card-badge">✅</div><div class="card-tag">EN ROUTE</div></div>
            <div class="card-title">Handover complete</div>
            <div class="card-desc">Rear doors shut. The van leaves the stop and heads back to the depot.</div>
            <div class="spec-grid">
                <div class="spec-item"><div class="spec-label">Status</div><div class="spec-value highlight">Delivered</div></div>
                <div class="spec-item"><div class="spec-label">Next stop</div><div class="spec-value">Depot</div></div>
            </div>
        </div>
        <div class="card-overlay card-finale" id="outro-card">
            <div class="card-header-flex"><div class="card-badge">🛣️</div><div class="card-tag">CLEAR</div></div>
            <div class="card-title">Van clear of the stop</div>
            <div class="card-desc">The run is closed. The depot is next.</div>
        </div>
        <div class="card-overlay card-left" id="warehouse-card">
            <div class="card-header-flex"><div class="card-badge">🏭</div><div class="card-tag">DEPOT</div></div>
            <div class="card-title">Back at the yard</div>
            <div class="card-desc">Dock doors, parked trucks, and the next load already waiting.</div>
            <div class="spec-grid">
                <div class="spec-item"><div class="spec-label">Site</div><div class="spec-value highlight">Durban depot</div></div>
                <div class="spec-item"><div class="spec-label">Queue</div><div class="spec-value">Ready</div></div>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid py-5" style="position: relative; z-index: 20; background-color: #0b1120;">
    <div class="row text-center mb-4">
        <div class="col">
            <h2 class="font-weight-bold text-white"><i class="fa-solid fa-comments text-primary mr-2"></i>What Our Customers Say</h2>
            <p class="text-muted">Real feedback from businesses and individuals who trust our fleet.</p>
        </div>
    </div>
    @{
        var reviewsList = new List<dynamic>();
        if (Model != null && Model.Reviews != null && Model.Reviews.Any())
        {
            foreach (var r in Model.Reviews)
            {
                reviewsList.Add(new { Rating = r.Rating, Comment = r.Comment, CustomerName = r.CustomerName, DatePosted = r.DatePosted.ToString("dd MMM yyyy") });
            }
        }
        var defaultReviews = new[] {
            new { Rating = 5, Comment = "The secure vault containment is top tier.", CustomerName = "Jessica Naidoo", DatePosted = "23 Aug 2026" },
            new { Rating = 5, Comment = "Incredible service! Our shipment arrived ahead of schedule.", CustomerName = "Sipho Mthethwa", DatePosted = "22 Aug 2026" },
            new { Rating = 5, Comment = "Absolute game changer for our regional supply chain and tracking.", CustomerName = "Priya Pillay", DatePosted = "20 Aug 2026" },
            new { Rating = 5, Comment = "Lightning-fast dispatch times and professional drivers every single time.", CustomerName = "Devan Govender", DatePosted = "18 Aug 2026" },
            new { Rating = 4, Comment = "Exceptional live telemetry accuracy. We always know where our cargo is.", CustomerName = "Zinhle Khumalo", DatePosted = "15 Aug 2026" },
            new { Rating = 5, Comment = "Top-tier logistics partner. Seamless integration with our warehouse.", CustomerName = "Michael van der Merwe", DatePosted = "12 Aug 2026" }
        };
        if (!reviewsList.Any()) { foreach (var dr in defaultReviews) { reviewsList.Add(dr); } }
        else if (reviewsList.Count < 6) { foreach (var dr in defaultReviews) { if (!reviewsList.Any(x => x.CustomerName == dr.CustomerName)) { reviewsList.Add(dr); } } }
    }
    <div class="reviews-marquee-container mb-3">
        <div class="reviews-track">
            @for (int loop = 0; loop < 2; loop++)
            {
                foreach (var review in reviewsList)
                {
                    <div class="review-card-wrapper">
                        <div class="card h-100 shadow-sm border-0 bg-light">
                            <div class="card-body d-flex flex-column justify-content-between p-4">
                                <div>
                                    <div class="mb-2 text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {<i class="fa-solid fa-star"></i> }
                                            else
                                            { <i class="fa-regular fa-star"></i>}
                                        }
                                    </div>
                                    <p class="card-text font-italic text-dark">"@review.Comment"</p>
                                </div>
                                <div class="border-top pt-2 mt-3 d-flex justify-content-between align-items-center">
                                    <span class="font-weight-bold text-primary small"><i class="fa-solid fa-user-circle mr-1"></i>@review.CustomerName</span>
                                    <span class="text-muted small">@review.DatePosted</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
<script>
    const container = document.getElementById('canvas-container');
    const loadingScreen = document.getElementById('loading-screen');
    const scrollWrapper = document.getElementById('scroll-wrapper');
    const scrollNav = document.getElementById('scroll-nav');
    const cargoCard = document.getElementById('cargo-card');
    const driverCard = document.getElementById('driver-card');
    const deliveryCard = document.getElementById('delivery-card');
    const outroCard = document.getElementById('outro-card');
    const warehouseCard = document.getElementById('warehouse-card');
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0f172a);
    const camera = new THREE.PerspectiveCamera(42, container.clientWidth / container.clientHeight, 0.1, 2000);
    let currentCamPos = new THREE.Vector3(3.4, 1.1, 4.2);
    let targetCamPos = new THREE.Vector3(3.4, 1.1, 4.2);
    let currentLookAt = new THREE.Vector3(0.2, 0.5, 0.2);
    let targetLookAt = new THREE.Vector3(0.2, 0.5, 0.2);
    camera.position.copy(currentCamPos);
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false, powerPreference: 'high-performance' });
    renderer.setClearColor(0x0f172a, 1);
    renderer.outputEncoding = THREE.sRGBEncoding;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.setSize(container.clientWidth, container.clientHeight, false);
    container.appendChild(renderer.domElement);
    scene.add(new THREE.AmbientLight(0xffffff, 0.85));
    const keyLight = new THREE.DirectionalLight(0xffffff, 1.05);
    keyLight.position.set(7, 9, 5);
    scene.add(keyLight);
    const cameraWaypoints = [
        { camPos: { x: 3.4, y: 1.1, z: 4.2 }, lookAt: { x: 0.2, y: 0.5, z: 0.2 }, vanRotY: 0.4 },
        { camPos: { x: -1.8, y: 1.5, z: 2.2 }, lookAt: { x: -0.3, y: 0.8, z: 0.2 }, vanRotY: 1.8 },
        { camPos: { x: -3.2, y: 0.9, z: -3.6 }, lookAt: { x: -0.2, y: 0.6, z: -0.2 }, vanRotY: 4.1 }
    ];
    const loader = new THREE.GLTFLoader();
    let vanModel = null, boxesModel = null, driverModel = null, warehouseModel = null;
    let targetVanRotY = 0.4, targetVanX = 0, targetVanZ = 0, targetBoxesRotY = 0, targetDriverRotY = 0;
    let targetWarehouseX = -18, targetWarehouseRotY = 0;
    let boxesVisible = false, driverVisible = false, warehouseVisible = false, vanVisible = true;
    function fitAndGround(model, targetHeight) {
        const box = new THREE.Box3().setFromObject(model);
        const size = new THREE.Vector3();
        box.getSize(size);
        model.scale.setScalar(targetHeight / Math.max(size.y, 0.001));
        const fitted = new THREE.Box3().setFromObject(model);
        const center = new THREE.Vector3();
        fitted.getCenter(center);
        model.position.x -= center.x;
        model.position.z -= center.z;
        model.position.y -= fitted.min.y;
    }
    function fitOverview(model, targetSize) {
        const box = new THREE.Box3().setFromObject(model);
        const size = new THREE.Vector3();
        box.getSize(size);
        const maxDim = Math.max(size.x, size.y, size.z, 0.001);
        model.scale.setScalar(targetSize / maxDim);
        const fitted = new THREE.Box3().setFromObject(model);
        const center = new THREE.Vector3();
        fitted.getCenter(center);
        model.position.x -= center.x;
        model.position.z -= center.z;
        model.position.y -= fitted.min.y;
    }
    function paint(model) {
        const maxAniso = renderer.capabilities.getMaxAnisotropy();
        model.traverse(c => {
            if (!c.isMesh || !c.material) return;
            const mats = Array.isArray(c.material) ? c.material : [c.material];
            mats.forEach(m => {
                if (m.map) { m.map.anisotropy = maxAniso; m.map.needsUpdate = true; }
                m.needsUpdate = true;
            });
        });
    }
    loader.load('@Url.Content("~/Content/models/van.glb")', function (gltf) {
        vanModel = gltf.scene;
        paint(vanModel);
        scene.add(vanModel);
        const box = new THREE.Box3().setFromObject(vanModel);
        vanModel.position.y -= box.min.y;
        loadingScreen.style.display = 'none';
    }, undefined, function () { loadingScreen.innerText = 'Error loading van.'; });
    loader.load('@Url.Content("~/Content/models/boxes.glb")', function (gltf) {
        boxesModel = gltf.scene; fitAndGround(boxesModel, 1.7); boxesModel.visible = false; paint(boxesModel); scene.add(boxesModel);
    });
    loader.load('@Url.Content("~/Content/models/driver.glb")', function (gltf) {
        driverModel = gltf.scene; fitAndGround(driverModel, 1.65); driverModel.visible = false; paint(driverModel); scene.add(driverModel);
    });
    loader.load('@Url.Content("~/Content/models/warehouse.glb")', function (gltf) {
        warehouseModel = gltf.scene;
        fitOverview(warehouseModel, 16);
        warehouseModel.position.x = -18;
        warehouseModel.visible = false;
        paint(warehouseModel);
        scene.add(warehouseModel);
    }, function (xhr) {
        if (xhr.total) loadingScreen.innerText = 'LOADING DEPOT... ' + Math.round((xhr.loaded / xhr.total) * 100) + '%';
    }, function (error) { console.error('Error loading warehouse:', error); });
    const cards = [document.getElementById('card-1'), document.getElementById('card-2'), document.getElementById('card-3')];
    const dots = document.querySelectorAll('.dot');
    function setCamera(pos, look) { targetCamPos.set(pos.x, pos.y, pos.z); targetLookAt.set(look.x, look.y, look.z); }
    window.addEventListener('scroll', () => {
        const maxScroll = scrollWrapper.offsetHeight - window.innerHeight;
        const t = Math.min(Math.max(window.scrollY / maxScroll, 0), 1);
        const past = window.scrollY >= maxScroll - 50;
        let activeDot = 0;
        boxesVisible = false; driverVisible = false; warehouseVisible = false; vanVisible = true;
        cargoCard.classList.remove('active');
        driverCard.classList.remove('active');
        deliveryCard.classList.remove('active');
        outroCard.classList.remove('active');
        warehouseCard.classList.remove('active');
        targetVanZ = 0;
        if (t < 0.18) {
            const local = t / 0.18;
            const p0 = local <= 0.5 ? cameraWaypoints[0] : cameraWaypoints[1];
            const p1 = local <= 0.5 ? cameraWaypoints[1] : cameraWaypoints[2];
            const f = local <= 0.5 ? local / 0.5 : (local - 0.5) / 0.5;
            setCamera(
                { x: THREE.MathUtils.lerp(p0.camPos.x, p1.camPos.x, f), y: THREE.MathUtils.lerp(p0.camPos.y, p1.camPos.y, f), z: THREE.MathUtils.lerp(p0.camPos.z, p1.camPos.z, f) },
                { x: THREE.MathUtils.lerp(p0.lookAt.x, p1.lookAt.x, f), y: THREE.MathUtils.lerp(p0.lookAt.y, p1.lookAt.y, f), z: THREE.MathUtils.lerp(p0.lookAt.z, p1.lookAt.z, f) }
            );
            targetVanRotY = THREE.MathUtils.lerp(p0.vanRotY, p1.vanRotY, f);
            targetVanX = 0;
            activeDot = local < 0.33 ? 0 : (local < 0.66 ? 1 : 2);
            cards.forEach((card, i) => card.classList.toggle('active', i === activeDot && !past));
        } else if (t < 0.24) {
            setCamera({ x: -2.2, y: 1.2, z: 4.4 }, { x: 1.5, y: 0.6, z: 0 });
            targetVanRotY = 1.55;
            targetVanX = THREE.MathUtils.lerp(0, 9, (t - 0.18) / 0.06);
            activeDot = 2;
            cards.forEach(c => c.classList.remove('active'));
        } else if (t < 0.34) {
            const sway = THREE.MathUtils.lerp(-1, 1, (t - 0.24) / 0.10);
            setCamera({ x: sway * 2.6, y: 1.2, z: 3.4 }, { x: sway * 0.55, y: 0.7, z: 0 });
            targetVanX = 9; targetBoxesRotY = sway * 0.7; boxesVisible = true; activeDot = 3;
            cards.forEach(c => c.classList.remove('active'));
            cargoCard.classList.toggle('active', !past);
        } else if (t < 0.44) {
            const angle = ((t - 0.34) / 0.10) * Math.PI * 2;
            setCamera({ x: Math.sin(angle) * 2.5, y: 1.15, z: Math.cos(angle) * 2.5 }, { x: 0, y: 0.85, z: 0 });
            targetVanX = 9; targetDriverRotY = angle * 0.18; driverVisible = true; activeDot = 4;
            cards.forEach(c => c.classList.remove('active'));
            driverCard.classList.toggle('active', !past);
        } else if (t < 0.52) {
            const back = (t - 0.44) / 0.08;
            setCamera({ x: THREE.MathUtils.lerp(2.4, 0, back), y: 1.2, z: 5.2 }, { x: 0, y: 0.6, z: 0 });
            targetVanRotY = THREE.MathUtils.lerp(0.35, Math.PI, back);
            targetVanX = THREE.MathUtils.lerp(9, 0, back);
            activeDot = 4;
            cards.forEach(c => c.classList.remove('active'));
        } else if (t < 0.58) {
            const lift = (t - 0.52) / 0.06;
            setCamera(
                { x: 0, y: THREE.MathUtils.lerp(1.4, 5.2, lift), z: THREE.MathUtils.lerp(5.2, 1.4, lift) },
                { x: 0, y: 0.5, z: -0.4 }
            );
            targetVanRotY = Math.PI;
            targetVanX = 0;
            activeDot = 4;
            cards.forEach(c => c.classList.remove('active'));
            deliveryCard.classList.toggle('active', !past);
        } else if (t < 0.64) {
            const away = (t - 0.58) / 0.06;
            targetVanX = THREE.MathUtils.lerp(0, 22, away);
            targetVanRotY = Math.PI;
            setCamera({ x: 0, y: 5.2, z: 1.6 }, { x: 0, y: 0.45, z: -0.2 });
            activeDot = 4;
            cards.forEach(c => c.classList.remove('active'));
            outroCard.classList.toggle('active', away > 0.55 && !past);
        } else {
            const enter = (t - 0.64) / 0.36;
            vanVisible = false;
            targetVanX = 22;
            warehouseVisible = true;
            targetWarehouseX = THREE.MathUtils.lerp(-18, 1.2, Math.min(enter / 0.08, 1));
            targetWarehouseRotY = 0;
            const shots = [
                { x: 1.2, y: 4.45, z: 13.4, lx: 1.2, ly: 1.4, lz: 0 },
                { x: 1.2, y: 1.98, z: 9.4, lx: 1.2, ly: 1.3, lz: 0 },
                { x: 7.5, y: 1.88, z: 6.3, lx: 1.2, ly: 1.2, lz: 0 },
                { x: 10.4, y: 2.1, z: 1.2, lx: 1.2, ly: 1.2, lz: 0 },
                { x: 7.3, y: 1.96, z: -6.4, lx: 1.2, ly: 1.15, lz: 0 },
                { x: 1.2, y: 2.28, z: -10.3, lx: 1.2, ly: 1.2, lz: 0 },
                { x: -6.3, y: 1.87, z: -6.6, lx: 1.2, ly: 1.15, lz: 0 },
                { x: -9.2, y: 2.1, z: 1.2, lx: 1.2, ly: 1.2, lz: 0 },
                { x: 1.2, y: 8.15, z: 6.5, lx: 1.2, ly: 0.4, lz: 0 },
                { x: 1.2, y: 1.65, z: 4.85, lx: 1.2, ly: 1.2, lz: 0 },
                { x: 1.2, y: 1.38, z: 1.25, lx: 1.2, ly: 1.2, lz: -1.5 },
                { x: 0.05, y: 1.38, z: -0.7, lx: 2.5, ly: 1.2, lz: -0.7 },
                { x: 2.7, y: 1.48, z: -0.15, lx: 1.2, ly: 1.2, lz: 1.7 },
                { x: 1.2, y: 3.2, z: 11.1, lx: 1.2, ly: 1.3, lz: 0 }
            ];
            const scaled = Math.min(Math.max((enter - 0.06) / 0.94, 0), 0.999);
            const i = Math.floor(scaled * (shots.length - 1));
            const f = scaled * (shots.length - 1) - i;
            const a = shots[i];
            const b = shots[Math.min(i + 1, shots.length - 1)];
            setCamera(
                { x: THREE.MathUtils.lerp(a.x, b.x, f), y: THREE.MathUtils.lerp(a.y, b.y, f), z: THREE.MathUtils.lerp(a.z, b.z, f) },
                { x: THREE.MathUtils.lerp(a.lx, b.lx, f), y: THREE.MathUtils.lerp(a.ly, b.ly, f), z: THREE.MathUtils.lerp(a.lz, b.lz, f) }
            );
            activeDot = 5;
            cards.forEach(c => c.classList.remove('active'));
            warehouseCard.classList.toggle('active', enter > 0.08 && enter < 0.92 && !past);
        }
        dots.forEach((dot, i) => dot.classList.toggle('active', i === activeDot));
        if (scrollNav) { scrollNav.style.opacity = past ? '0' : '1'; }
    });
    cards.forEach(card => {
        card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            card.style.transform = `translateY(-50%) rotateY(${(e.clientX - rect.left - rect.width / 2) * 0.04}deg) rotateX(${-(e.clientY - rect.top - rect.height / 2) * 0.04}deg) scale(1.02)`;
        });
        card.addEventListener('mouseleave', () => { card.style.transform = ''; });
    });
    function animate() {
        requestAnimationFrame(animate);
        currentCamPos.lerp(targetCamPos, 0.06);
        currentLookAt.lerp(targetLookAt, 0.06);
        camera.position.copy(currentCamPos);
        camera.lookAt(currentLookAt);
        if (vanModel) {
            vanModel.visible = vanVisible;
            vanModel.rotation.y += (targetVanRotY - vanModel.rotation.y) * 0.06;
            vanModel.position.x += (targetVanX - vanModel.position.x) * 0.06;
            vanModel.position.z += (targetVanZ - vanModel.position.z) * 0.06;
        }
        if (boxesModel) { boxesModel.visible = boxesVisible; boxesModel.rotation.y += (targetBoxesRotY - boxesModel.rotation.y) * 0.06; }
        if (driverModel) { driverModel.visible = driverVisible; driverModel.rotation.y += (targetDriverRotY - driverModel.rotation.y) * 0.06; }
        if (warehouseModel) {
            warehouseModel.visible = warehouseVisible;
            warehouseModel.position.x += (targetWarehouseX - warehouseModel.position.x) * 0.05;
            warehouseModel.rotation.y += (targetWarehouseRotY - warehouseModel.rotation.y) * 0.05;
        }
        renderer.render(scene, camera);
    }
    animate();
    window.addEventListener('resize', () => {
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight, false);
    });
</script>