@{
    ViewBag.Title = "Contact & Operations Support";
}

<div class="container mt-4" style="max-width: 1000px;">
    <div class="mb-4">
        <h2 class="font-weight-bold mb-1">Logistics Support Center</h2>
        <p class="text-muted">Get in touch with dispatch, operations control, or fleet support</p>
    </div>

    <!-- Success / Error Banners -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 small py-3 mb-4" style="background: rgba(34, 197, 94, 0.15); color: #86efac; border-radius: 8px;">
            <i class="fa-solid fa-circle-check mr-1"></i> @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 small py-3 mb-4" style="background: rgba(239, 68, 68, 0.15); color: #fca5a5; border-radius: 8px;">
            <i class="fa-solid fa-circle-exclamation mr-1"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="row">
        <!-- Contact Cards -->
        <div class="col-md-5 mb-4">
            <div class="form-card mb-3">
                <h5 class="font-weight-bold mb-3"><i class="fa-solid fa-building text-primary mr-2"></i>Headquarters</h5>
                <p class="mb-1 text-secondary"><strong>Keystone Logistics Hub</strong></p>
                <p class="text-muted mb-0">Hammarsdale Industrial Zone, KZN</p>
            </div>

            <div class="form-card mb-3">
                <h5 class="font-weight-bold mb-3"><i class="fa-solid fa-headset text-primary mr-2"></i>Direct Dispatch Lines</h5>
                <p class="mb-1"><strong>Phone:</strong> +27 (0)31 500 1234</p>
                <p class="mb-1"><strong>Emergency Line:</strong> 0800 539 786</p>
                <p class="mb-0"><strong>Email:</strong> support@keystonelogistics.co.za</p>
            </div>
        </div>

        <!-- Contact Form Card -->
        <div class="col-md-7 mb-4">
            <div class="form-card">
                <h5 class="font-weight-bold mb-3">Send Dispatch Support Inquiry</h5>
                
                @using (Html.BeginForm("Contact", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group mb-3">
                        <label class="font-weight-bold small">Your Name</label>
                        <input type="text" name="name" class="form-control form-control-custom" placeholder="Full name" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold small">Email Address</label>
                        <input type="email" name="email" class="form-control form-control-custom" placeholder="name@company.co.za" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold small">Message / Inquiry</label>
                        <textarea name="message" class="form-control form-control-custom" rows="4" placeholder="Describe the operational request or issue..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary font-weight-bold btn-block py-2" style="border-radius: 8px;">
                        Submit Inquiry
                    </button>
                }
            </div>
        </div>
    </div>
</div>