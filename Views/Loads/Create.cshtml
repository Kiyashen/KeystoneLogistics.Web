@model KeystoneLogistics.Models.Load

@{
    ViewBag.Title = "Book Freight Shipment";
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold mb-1"><i class="fa-solid fa-truck-ramp-box text-info mr-2"></i>Book Freight Shipment</h2>
            <p class="text-muted mb-0">Submit your cargo pickup details for administrative dispatch</p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary font-weight-bold px-3 py-2" style="border-radius: 8px;">
            <i class="fa-solid fa-arrow-left mr-1"></i> Back
        </a>
    </div>

    <div class="card shadow-sm border-0 p-4 rounded-lg bg-white">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="form-group mb-3">
                <label class="font-weight-bold text-dark">Pickup Location</label>
                @Html.TextBoxFor(model => model.PickupLocation, new { @class = "form-control", @placeholder = "e.g., Durban Port Terminal", @required = "required" })
                @Html.ValidationMessageFor(model => model.PickupLocation, "", new { @class = "text-danger small" })
            </div>

            <div class="form-group mb-3">
                <label class="font-weight-bold text-dark">Dropoff Location</label>
                @Html.TextBoxFor(model => model.DropoffLocation, new { @class = "form-control", @placeholder = "e.g., Pietermaritzburg Central Hub", @required = "required" })
                @Html.ValidationMessageFor(model => model.DropoffLocation, "", new { @class = "text-danger small" })
            </div>

            <div class="form-group mb-4">
                <label class="font-weight-bold text-dark">Cargo Description</label>
                @Html.TextAreaFor(model => model.CargoDescription, new { @class = "form-control", @rows = "4", @placeholder = "e.g., 50 Pallets of Consumer Goods", @required = "required" })
                @Html.ValidationMessageFor(model => model.CargoDescription, "", new { @class = "text-danger small" })
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a href="@Url.Action("Index")" class="btn btn-light font-weight-bold px-4 py-2" style="border-radius: 8px;">Cancel</a>
                <button type="submit" class="btn btn-success font-weight-bold px-4 py-2" style="border-radius: 8px;">
                    <i class="fa-solid fa-paper-plane mr-1"></i> Submit Work Request
                </button>
            </div>
        }
    </div>
</div>