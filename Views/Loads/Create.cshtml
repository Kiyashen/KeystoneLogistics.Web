@model KeystoneLogistics.Models.Load

@{
    ViewBag.Title = "Book Freight Shipment";
}

<style>
    .glass-card-dark {
        background: rgba(15, 23, 42, 0.85) !important;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        border-radius: 16px !important;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        color: #f8fafc;
    }

    .form-control-dark {
        background: rgba(255, 255, 255, 0.03) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #f8fafc !important;
        border-radius: 8px !important;
    }

        .form-control-dark:focus {
            background: rgba(255, 255, 255, 0.06) !important;
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 0.2rem rgba(56, 189, 248, 0.25) !important;
            color: #f8fafc !important;
        }

        /* Fix dropdown option contrast in dark theme */
        .form-control-dark option {
            background-color: #0f172a;
            color: #f8fafc;
        }

    .tc-scroll-box {
        max-height: 140px;
        overflow-y: auto;
        background: rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 12px;
        font-size: 12px;
        color: #94a3b8;
    }
</style>

<div class="container py-4" style="max-width: 750px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold text-white mb-1">
                <i class="fa-solid fa-truck-ramp-box text-info mr-2"></i>Book Freight Shipment
            </h2>
            <p class="text-muted mb-0" style="color: #94a3b8 !important;">Submit your cargo pickup details for administrative dispatch</p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-light font-weight-bold px-3 py-2" style="border-radius: 8px;">
            <i class="fa-solid fa-arrow-left mr-1"></i> Back
        </a>
    </div>

    <div class="glass-card-dark p-4 p-md-5">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger border-0 mb-4" })

            <!-- Customer Database Verification Section -->
            <div class="mb-4 pb-3 border-bottom" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                <h5 class="text-white font-weight-bold mb-3">
                    <i class="fa-solid fa-user-shield text-info mr-2"></i>Customer Database Verification
                </h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="text-uppercase font-weight-bold small text-muted" style="letter-spacing: 0.5px;">Customer Username / ID *</label>
                        <input type="text" id="CustomerName" name="CustomerName" class="form-control form-control-dark" value="customer1" readonly />
                        <small class="text-muted form-text">Authenticated session active.</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="text-uppercase font-weight-bold small text-muted" style="letter-spacing: 0.5px;">Select Registered Company *</label>
                        <select id="AccountReference" name="AccountReference" class="form-control form-control-dark" required>
                            <option value="">-- Select Company from Database --</option>
                            @if (ViewBag.CustomerList != null)
                            {
                                foreach (var item in (SelectList)ViewBag.CustomerList)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                        <small class="text-muted form-text">Choose active account from registry.</small>
                    </div>
                </div>
            </div>

            <!-- Shipment & Route Specifications -->
            <div class="mb-4">
                <h5 class="text-white font-weight-bold mb-3">
                    <i class="fa-solid fa-route text-primary mr-2"></i>Shipment Specifications
                </h5>

                <div class="form-group mb-3">
                    <label class="font-weight-bold text-white small text-uppercase" style="letter-spacing: 0.5px;">Pickup Location *</label>
                    @Html.TextBoxFor(model => model.PickupLocation, new { @class = "form-control form-control-dark", @id = "PickupLocation", @placeholder = "e.g., Durban Port Terminal", @required = "required" })
                    @Html.ValidationMessageFor(model => model.PickupLocation, "", new { @class = "text-danger small" })
                </div>

                <div class="form-group mb-3">
                    <label class="font-weight-bold text-white small text-uppercase" style="letter-spacing: 0.5px;">Dropoff Location *</label>
                    @Html.TextBoxFor(model => model.DropoffLocation, new { @class = "form-control form-control-dark", @id = "DropoffLocation", @placeholder = "e.g., Pietermaritzburg Central Hub", @required = "required" })
                    @Html.ValidationMessageFor(model => model.DropoffLocation, "", new { @class = "text-danger small" })
                </div>

                <div class="form-group mb-4">
                    <label class="font-weight-bold text-white small text-uppercase" style="letter-spacing: 0.5px;">Cargo Description *</label>
                    @Html.TextAreaFor(model => model.CargoDescription, new { @class = "form-control form-control-dark", @id = "CargoDescription", @rows = "4", @placeholder = "e.g., 50 Pallets of Consumer Goods", @required = "required" })
                    @Html.ValidationMessageFor(model => model.CargoDescription, "", new { @class = "text-danger small" })
                </div>
            </div>

            <!-- Terms & Conditions Liability Waiver Box -->
            <div class="mb-4">
                <label class="text-uppercase font-weight-bold small text-muted mb-2" style="letter-spacing: 0.5px;">Terms, Conditions & Liability Waiver *</label>
                <div class="tc-scroll-box mb-3">
                    <p class="mb-2"><strong>1. Database Registry Policy:</strong> Bookings are strictly restricted to verified entities listed in our active database. Unregistered entities will be automatically rejected by our dispatch system.</p>
                    <p class="mb-2"><strong>2. Limitation of Liability & Damage Waiver:</strong> Keystone Logistics executes delivery strictly according to administrative rules and instructions. Once your package is dispatched, Keystone Logistics is <em>not liable</em> for any incidental damage, wear and tear, spoilage, or transit loss.</p>
                    <p class="mb-2"><strong>3. Misrouting & Incorrect Location Policy:</strong> If packages go to the wrong location or fail to reach the intended recipient because we must follow strict dispatch rules and metadata provided, Keystone Logistics accepts zero legal or financial liability.</p>
                    <p class="mb-0"><strong>4. Acceptance of Rules:</strong> By submitting this dispatch request, you acknowledge that our delivery logs and procedural guidelines serve as absolute binding proof of execution.</p>
                </div>

                <div class="custom-control custom-checkbox">
                    <input type="checkbox" class="custom-control-input" id="acceptTerms" required>
                    <label class="custom-control-label small text-muted" for="acceptTerms">
                        I confirm that my account is registered in the Keystone database, and I fully accept all Terms, Conditions, and Liability Waivers.
                    </label>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 8px;">Cancel</a>
                <button type="submit" class="btn font-weight-bold px-4 py-2 text-white shadow-sm" style="border-radius: 8px; background-color: #16a34a; border: none;">
                    <i class="fa-solid fa-paper-plane mr-1"></i> Submit Work Request
                </button>
            </div>
        }
    </div>
</div>