@model IEnumerable<KeystoneLogistics.Models.Load>
@{
    ViewBag.Title = "Freight Loads Dashboard";
    string userRole = Session["UserRole"]?.ToString() ?? "";
    var availableVehicles = (ViewBag.AvailableVehicles as IEnumerable<KeystoneLogistics.Models.Vehicle>)?.ToList()
                            ?? new List<KeystoneLogistics.Models.Vehicle>();
    var availableDrivers = (ViewBag.AvailableDrivers as IEnumerable<KeystoneLogistics.Models.Driver>)?.ToList()
                           ?? new List<KeystoneLogistics.Models.Driver>();
    var loadList = Model ?? Enumerable.Empty<KeystoneLogistics.Models.Load>();
    int pendingCount = loadList.Count(l => l.WorkStatus == "Pending" || l.Status == "Pending");
    int enRouteCount = loadList.Count(l => l.Status == "En Route" || l.Status == "Dispatched");
    var auditLogs = ViewBag.AuditLogs as IEnumerable<KeystoneLogistics.Models.AuditLog>
                    ?? Enumerable.Empty<KeystoneLogistics.Models.AuditLog>();
}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold"><i class="fa-solid fa-boxes-stacked text-info mr-2"></i>Freight Loads Management</h2>
            <p class="text-muted mb-0">Track, dispatch, and process regional logistics shipments</p>
        </div>
        @if (userRole == "Customer")
        {
            <a href="@Url.Action("Create", "Loads")" class="btn btn-success font-weight-bold shadow-sm">
                <i class="fa-solid fa-plus mr-1"></i> Book New Shipment
            </a>
        }
    </div>
    @if (userRole != "Driver")
    {
        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <div class="card shadow" style="border-left: 5px solid #C47B2D;">
                    <div class="card-body py-3">
                        <div class="text-uppercase small font-weight-bold mb-1">Pending Approvals</div>
                        <div class="h3 mb-0 font-weight-bold">@pendingCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card shadow" style="border-left: 5px solid #2F6F5E;">
                    <div class="card-body py-3">
                        <div class="text-uppercase small font-weight-bold mb-1">Active / En Route Loads</div>
                        <div class="h3 mb-0 font-weight-bold">@enRouteCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card shadow" style="border-left: 5px solid #2F6F5E;">
                    <div class="card-body py-3">
                        <div class="text-uppercase small font-weight-bold mb-1">Registered Drivers</div>
                        <div class="h3 mb-0 font-weight-bold">@availableDrivers.Count</div>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (userRole == "Driver")
    {
        <div class="row">
            @if (!loadList.Any())
            {
                <div class="col-12">
                    <div class="card shadow p-4 text-center text-muted">No active jobs assigned.</div>
                </div>
            }
            else
            {
                foreach (var item in loadList)
                {
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card shadow h-100" style="border-top: 4px solid #2F6F5E;">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="font-weight-bold mb-0">@item.TrackingNumber</h5>
                                    <span class="badge badge-info">@item.Status</span>
                                </div>
                                <div class="small text-muted mb-1"><i class="fa-solid fa-location-dot mr-1"></i>@item.PickupLocation</div>
                                <div class="small text-muted mb-3"><i class="fa-solid fa-flag-checkered mr-1"></i>@item.DropoffLocation</div>
                                <div class="small mb-3"><strong>Cargo:</strong> @item.CargoDescription</div>
                                <button type="button" class="btn btn-sm btn-outline-info mb-3"
                                        onclick="openMapModal('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.Status')">
                                    Live Route
                                </button>
                                @if (item.Status == "Dispatched" && !(item.IsCollected ?? false))
                                {
                                    using (Html.BeginForm("VerifyCollection", "Loads", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.LoadId" />
                                        <input type="text" name="enteredPasscode" class="form-control form-control-lg mb-2 text-center" placeholder="4-Digit PIN" required style="font-size:1.4rem; letter-spacing:4px;" />
                                        <button type="submit" class="btn btn-primary btn-lg btn-block">Verify Pickup</button>
                                    }
                                }
                                else if ((item.IsCollected ?? false) && item.Status != "Delivered" && item.Status != "Paid / Processing" && item.Status != "Completed")
                                {
                                    <button type="button" class="btn btn-success btn-lg btn-block" data-toggle="modal" data-target="#deliveryModal@(item.LoadId)">Confirm Delivery</button>
                                }
                                else if (item.Status == "Delivered" || item.Status == "Completed")
                                {
                                    <span class="badge badge-success p-2">Job Completed</span>
                                }
                                else if (item.Status == "Queued")
                                {
                                    <span class="badge badge-warning p-2">Queued — wait for current job to finish</span>
                                }
                                else
                                {
                                    <span class="small text-muted">Waiting for dispatch...</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="card shadow mb-5">
            <div class="card-header d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 font-weight-bold">Shipment Records</h5>
                <input type="text" id="loadSearchInput" class="form-control form-control-sm" style="width:300px;" placeholder="Search shipments..." onkeyup="filterTable()" />
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="loadsTable">
                        <thead>
                            <tr>
                                <th>Tracking #</th>
                                <th>Route</th>
                                <th>Cargo</th>
                                <th>Status</th>
                                <th>Assigned Driver / Vehicle</th>
                                <th>Collection PIN</th>
                                <th class="text-center">Workflow Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!loadList.Any())
                            {
                                <tr><td colspan="7" class="text-center py-4">No freight shipments found.</td></tr>
                            }
                            else
                            {
                                foreach (var item in loadList)
                                {
                                    <tr>
                                        <td><strong>@item.TrackingNumber</strong></td>
                                        <td>
                                            <div class="small"><strong>From:</strong> @item.PickupLocation</div>
                                            <div class="small mb-1"><strong>To:</strong> @item.DropoffLocation</div>
                                            <button type="button" class="btn btn-sm btn-outline-info mt-1"
                                                    onclick="openMapModal('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.Status')">
                                                Live Route
                                            </button>
                                        </td>
                                        <td>@item.CargoDescription</td>
                                        <td><span class="badge badge-secondary">@item.Status</span></td>
                                        <td>
                                            @if (item.Driver != null)
                                            {
                                                <div><strong>@item.Driver.FullName</strong></div>
                                                <div class="small">@(item.Driver.VehicleRegistration ?? "")</div>
                                            }
                                            else
                                            {
                                                <span>Unassigned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (userRole == "Admin" || userRole == "Customer")
                                            {
                                                <code>@(item.CollectionPasscode ?? "N/A")</code>
                                            }
                                            else
                                            {
                                                <span class="small">(Customer Provided)</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (userRole == "Admin" && (item.WorkStatus == "Pending" || item.Status == "Pending"))
                                            {
                                                using (Html.BeginForm("AcceptRequest", "Loads", FormMethod.Post, new { @class = "mb-2" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.LoadId" />
                                                    <select name="driverId" class="form-control form-control-sm mb-1" required>
                                                        <option value="">-- Assign Driver --</option>
                                                        @foreach (var driver in availableDrivers)
                                                        {
                                                            <option value="@driver.DriverId">@driver.FullName — @driver.VehicleRegistration</option>
                                                        }
                                                    </select>
                                                    <select name="routeSafety" class="form-control form-control-sm mb-1">
                                                        <option value="Safe">Safe Route</option>
                                                        <option value="Caution">Caution Required</option>
                                                        <option value="High Risk">High Risk</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-success btn-block">Accept & Email</button>
                                                }
                                                using (Html.BeginForm("RejectRequest", "Loads", FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.LoadId" />
                                                    <select name="rejectionReason" class="form-control form-control-sm mb-1" required>
                                                        <option value="">-- Select Reason --</option>
                                                        <option value="Location is too far">Location is too far</option>
                                                        <option value="Route is too dangerous">Route is too dangerous</option>
                                                        <option value="Invalid cargo specifications">Invalid cargo specifications</option>
                                                        <option value="Vehicle capacity exceeded">Vehicle capacity exceeded</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-outline-danger btn-block">Reject</button>
                                                }
                                            }
                                            else if (userRole == "Admin" && item.Status == "Paid / Processing")
                                            {
                                                <a href="@Url.Action("DriverCheckout", "Payment", new { id = item.LoadId })" class="btn btn-sm btn-success">Pay Driver</a>
                                            }
                                            else if (userRole == "Customer" && item.Status == "Delivered")
                                            {
                                                <a href="@Url.Action("Checkout", "Payment", new { id = item.LoadId })" class="btn btn-sm btn-success mb-1">Pay Now</a>
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        onclick="printPODReceipt('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.CargoDescription', 'Vehicle #@item.AssignedVehicleId', '@(item.CollectionPasscode ?? "N/A")')">
                                                    POD Receipt
                                                </button>
                                            }
                                            else if (item.Status == "Delivered")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        onclick="printPODReceipt('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.CargoDescription', 'Vehicle #@item.AssignedVehicleId', '@(item.CollectionPasscode ?? "N/A")')">
                                                    POD Receipt
                                                </button>
                                            }
                                            else if (item.Status == "Completed")
                                            {
                                                <span class="small">Job Fully Completed</span>
                                            }
                                            else
                                            {
                                                <span class="small">No action required</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    @if (userRole == "Admin")
    {
        var all = loadList.ToList();
        int totalJobs = all.Count;
        int pendingJobs = all.Count(l => l.Status == "Pending" || l.WorkStatus == "Pending");
        int queuedJobs = all.Count(l => l.Status == "Queued");
        int activeJobs = all.Count(l => l.Status == "Dispatched" || l.Status == "En Route");
        int deliveredJobs = all.Count(l => l.Status == "Delivered");
        int paidJobs = all.Count(l => l.Status == "Paid / Processing");
        int completedJobs = all.Count(l => l.Status == "Completed" || l.WorkStatus == "Completed");
        int rejectedJobs = all.Count(l => l.Status == "Cancelled" || l.WorkStatus == "Rejected");
        int decidedJobs = completedJobs + rejectedJobs;
        decimal completionRate = decidedJobs == 0 ? 0 : Math.Round((decimal)completedJobs / decidedJobs * 100, 1);
        decimal rejectRate = decidedJobs == 0 ? 0 : Math.Round((decimal)rejectedJobs / decidedJobs * 100, 1);
        int unassignedJobs = all.Count(l => l.DriverId == null && l.Status != "Cancelled");
        var driverRows = all.Where(l => l.Driver != null)
            .GroupBy(l => l.Driver.FullName)
            .Select(g => new
            {
                Name = g.Key,
                Jobs = g.Count(),
                Done = g.Count(x => x.Status == "Completed" || x.Status == "Delivered" || x.Status == "Paid / Processing")
            })
            .OrderByDescending(x => x.Jobs)
            .Take(5)
            .ToList();
        var customerRows = all.Where(l => l.Customer != null)
            .GroupBy(l => string.IsNullOrWhiteSpace(l.Customer.CompanyName) ? l.Customer.ContactPerson : l.Customer.CompanyName)
            .Select(g => new { Name = g.Key, Jobs = g.Count() })
            .OrderByDescending(x => x.Jobs)
            .Take(5)
            .ToList();
        <div class="card shadow mb-5" style="border-radius: 16px; overflow: hidden;">
            <div class="card-header py-3" style="background: #3A3226; color: #F4EFE6;">
                <h5 class="mb-0 font-weight-bold"><i class="fa-solid fa-chart-column mr-2"></i>Dispatch Analytics</h5>
                <small>Live figures from the shipment records above. Nothing here is sample data.</small>
            </div>
            <div class="card-body">
                <div class="row text-center mb-4">
                    <div class="col-6 col-md-2 mb-3"><div class="p-3 text-white" style="background:#C47B2D;border-radius:12px;"><div class="h3 mb-0">@pendingJobs</div><small>Waiting on admin</small></div></div>
                    <div class="col-6 col-md-2 mb-3"><div class="p-3 text-white" style="background:#2F6F5E;border-radius:12px;"><div class="h3 mb-0">@activeJobs</div><small>On the road</small></div></div>
                    <div class="col-6 col-md-2 mb-3"><div class="p-3 text-white" style="background:#3D6F8F;border-radius:12px;"><div class="h3 mb-0">@queuedJobs</div><small>Queued behind a job</small></div></div>
                    <div class="col-6 col-md-2 mb-3"><div class="p-3 text-white" style="background:#B45309;border-radius:12px;"><div class="h3 mb-0">@deliveredJobs</div><small>Awaiting payment</small></div></div>
                    <div class="col-6 col-md-2 mb-3"><div class="p-3 text-white" style="background:#166534;border-radius:12px;"><div class="h3 mb-0">@completionRate%</div><small>Completion rate</small></div></div>
                    <div class="col-6 col-md-2 mb-3"><div class="p-3 text-white" style="background:#9B2C2C;border-radius:12px;"><div class="h3 mb-0">@rejectRate%</div><small>Rejection rate</small></div></div>
                </div>
                <div class="row">
                    <div class="col-lg-7 mb-4">
                        <h6 class="font-weight-bold">Pipeline</h6>
                        <canvas id="statusChart" height="130"></canvas>
                    </div>
                    <div class="col-lg-5 mb-4">
                        <h6 class="font-weight-bold">Decided jobs</h6>
                        <canvas id="outcomeChart" height="130"></canvas>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="font-weight-bold">Driver workload</h6>
                        <table class="table table-sm table-bordered">
                            <thead style="background:#EBE3D4;"><tr><th>Driver</th><th>Assigned jobs</th><th>Delivered or paid</th></tr></thead>
                            <tbody>
                                @foreach (var row in driverRows)
                                {
                                    <tr><td>@row.Name</td><td>@row.Jobs</td><td>@row.Done</td></tr>
                                }
                                @if (!driverRows.Any())
                                {
                                    <tr><td colspan="3" class="text-muted">No drivers assigned yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="font-weight-bold">Customer demand</h6>
                        <table class="table table-sm table-bordered">
                            <thead style="background:#EBE3D4;"><tr><th>Customer</th><th>Bookings</th></tr></thead>
                            <tbody>
                                @foreach (var row in customerRows)
                                {
                                    <tr><td>@row.Name</td><td>@row.Jobs</td></tr>
                                }
                                @if (!customerRows.Any())
                                {
                                    <tr><td colspan="2" class="text-muted">No customer bookings yet.</td></tr>
                                }
                            </tbody>
                        </table>
                        <p class="small text-muted mb-0">Unassigned open jobs: @unassignedJobs. Paid and waiting for driver payout: @paidJobs. Closed jobs: @completedJobs of @totalJobs.</p>
                    </div>
                </div>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            new Chart(document.getElementById('statusChart'), {
                type: 'bar',
                data: {
                    labels: ['Pending', 'Queued', 'On road', 'Delivered', 'Paid', 'Completed', 'Rejected'],
                    datasets: [{
                        label: 'Shipments',
                        data: [@pendingJobs, @queuedJobs, @activeJobs, @deliveredJobs, @paidJobs, @completedJobs, @rejectedJobs],
                        backgroundColor: ['#C47B2D', '#3D6F8F', '#2F6F5E', '#B45309', '#166534', '#14532D', '#9B2C2C']
                    }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
            });
            new Chart(document.getElementById('outcomeChart'), {
                type: 'doughnut',
                data: {
                    labels: ['Completed', 'Rejected'],
                    datasets: [{ data: [@completedJobs, @rejectedJobs], backgroundColor: ['#2F6F5E', '#9B2C2C'] }]
                }
            });
        </script>
    }
    @if (userRole == "Admin")
    {
        <div class="card shadow mb-5">
            <div class="card-header py-3">
                <h5 class="mb-0 font-weight-bold">System Audit Trail & History</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Audit ID</th>
                                <th>Load ID</th>
                                <th>Action Performed</th>
                                <th>Shipment Ref</th>
                                <th>Performed By</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!auditLogs.Any())
                            {
                                <tr><td colspan="6" class="text-center py-4">No system audit logs found.</td></tr>
                            }
                            else
                            {
                                foreach (var log in auditLogs)
                                {
                                    <tr>
                                        <td>@log.AuditId</td>
                                        <td>#@log.LoadId</td>
                                        <td>@log.Action</td>
                                        <td>
                                            @(log.Load != null && !string.IsNullOrEmpty(log.Load.TrackingNumber)
                                                ? log.Load.TrackingNumber
                                                : "#" + log.LoadId)
                                        </td>
                                        <td>@log.PerformedBy</td>
                                        <td>@(log.Timestamp.HasValue ? log.Timestamp.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
@foreach (var item in loadList)
{
    if (userRole == "Driver" && (item.IsCollected ?? false) && item.Status != "Delivered" && item.Status != "Paid / Processing" && item.Status != "Completed")
    {
        <div class="modal fade" id="deliveryModal@(item.LoadId)" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    @using (Html.BeginForm("MarkDelivered", "Loads", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.LoadId" />
                        <div class="modal-header">
                            <h5 class="modal-title">Confirm Delivery</h5>
                            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                        </div>
                        <div class="modal-body">
                            <label class="small font-weight-bold">Tracking number</label>
                            <input type="text" name="scannedQRCode" class="form-control mb-3" placeholder="e.g. @item.TrackingNumber" required />
                            <label class="small font-weight-bold">Doorstep photo</label>
                            <video id="cam@(item.LoadId)" autoplay playsinline style="width:100%; border-radius:8px; background:#111; display:none;"></video>
                            <img id="shot@(item.LoadId)" alt="Delivery photo" style="width:100%; border-radius:8px; display:none;" />
                            <input type="file" name="podPhoto" id="file@(item.LoadId)" accept="image/*" capture="environment" class="d-none" required />
                            <button type="button" class="btn btn-outline-secondary btn-block mt-2" onclick="openDeliveryCamera(@item.LoadId)">Open camera</button>
                            <button type="button" class="btn btn-outline-success btn-block" onclick="snapDeliveryPhoto(@item.LoadId)">Snap photo</button>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success btn-sm">Confirm Delivery</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
<div class="modal fade" id="trackingMapModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mapModalTitle">Shipment Tracking</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="px-3 pt-2 pb-2">
                <button type="button" class="btn btn-sm btn-outline-info mr-1" onclick="zoomToStop('pickup')">Zoom pickup</button>
                <button type="button" class="btn btn-sm btn-outline-secondary mr-1" onclick="zoomToStop('dropoff')">Zoom dropoff</button>
                <button type="button" class="btn btn-sm btn-outline-dark" onclick="zoomToStop('route')">Full route</button>
            </div>
            <div class="modal-body p-0">
                <div id="leafletMap" style="height: 420px; width: 100%;"></div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="podModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div id="printablePOD" class="modal-body p-4 bg-white text-dark">
                <h4>KEYSTONE LOGISTICS</h4>
                <table class="table table-bordered table-sm">
                    <tr><th>Tracking Number</th><td id="podTracking"></td></tr>
                    <tr><th>Pickup Origin</th><td id="podPickup"></td></tr>
                    <tr><th>Dropoff Destination</th><td id="podDropoff"></td></tr>
                    <tr><th>Cargo Description</th><td id="podCargo"></td></tr>
                    <tr><th>Assigned Fleet</th><td id="podVehicle"></td></tr>
                    <tr><th>Verification PIN</th><td id="podPIN"></td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger" onclick="triggerPODPrint()">Print / Save PDF</button>
            </div>
        </div>
    </div>
</div>
<script>
    let map = null;
    let animationInterval = null;
    let lastPickup = null;
    let lastDropoff = null;
    let lastRoute = null;
    function lerp(start, end, t) { return start + (end - start) * t; }
    function zoomToStop(which) {
        if (!map) return;
        if (which === 'route' && lastRoute) {
            map.fitBounds(lastRoute.getBounds(), { padding: [40, 40] });
            return;
        }
        var point = which === 'dropoff' ? lastDropoff : lastPickup;
        if (point) map.setView(point, 16);
    }
    function knownPlace(address) {
        var a = (address || '').toLowerCase();
        if (a.indexOf('durban south bank') !== -1) return [-29.8728, 31.0235];
        if (a.indexOf('pietermaritzburg distribution') !== -1) return [-29.6432, 30.4118];
        if (a.indexOf('durban') !== -1) return [-29.8587, 31.0218];
        if (a.indexOf('pietermaritzburg') !== -1) return [-29.6006, 30.3794];
        return null;
    }
    async function geocodeAddress(address) {
        var known = knownPlace(address);
        if (known) return known;
        try {
            let query = address || '';
            if (query.toLowerCase().indexOf('south africa') === -1) query += ', South Africa';
            const response = await fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' + encodeURIComponent(query));
            const data = await response.json();
            if (data && data.length > 0) return [parseFloat(data[0].lat), parseFloat(data[0].lon)];
        } catch (err) { }
        return null;
    }
    async function roadRoute(pickupCoord, dropoffCoord) {
        try {
            var url = 'https://router.project-osrm.org/route/v1/driving/'
                + pickupCoord[1] + ',' + pickupCoord[0] + ';'
                + dropoffCoord[1] + ',' + dropoffCoord[0]
                + '?overview=full&geometries=geojson';
            var response = await fetch(url);
            var data = await response.json();
            if (data && data.routes && data.routes[0] && data.routes[0].geometry) {
                return data.routes[0].geometry.coordinates.map(function (c) {
                    return [c[1], c[0]];
                });
            }
        } catch (err) { }
        return [pickupCoord, dropoffCoord];
    }
    function openMapModal(trackingNum, pickup, dropoff, status) {
        var title = document.getElementById('mapModalTitle');
        if (title) title.innerText = 'Shipment Tracking (' + trackingNum + ')';
        var modal = document.getElementById('trackingMapModal');
        if (modal && window.jQuery) jQuery(modal).modal('show');
        if (animationInterval) clearInterval(animationInterval);
        var shownHandler = async function () {
            if (map !== null) map.remove();
            map = L.map('leafletMap').setView([-29.8587, 31.0218], 9);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap' }).addTo(map);
            let pickupCoord = await geocodeAddress(pickup) || [-29.8728, 31.0235];
            let dropoffCoord = await geocodeAddress(dropoff) || [-29.6432, 30.4118];
            lastPickup = pickupCoord;
            lastDropoff = dropoffCoord;
            L.marker(pickupCoord).addTo(map).bindPopup('Pickup: ' + pickup);
            L.marker(dropoffCoord).addTo(map).bindPopup('Destination: ' + dropoff);
            let routePoints = await roadRoute(pickupCoord, dropoffCoord);
            let vehicleMarker = L.marker(routePoints[0]).addTo(map);
            lastRoute = L.polyline(routePoints, { color: '#2F6F5E', weight: 5 }).addTo(map);
            map.fitBounds(lastRoute.getBounds(), { padding: [40, 40] });
            map.invalidateSize();
            if (status === 'En Route') {
                let i = 0;
                animationInterval = setInterval(function () {
                    i++;
                    if (i >= routePoints.length) i = 0;
                    vehicleMarker.setLatLng(routePoints[i]);
                }, 60);
            }
        };
        if (window.jQuery) {
            jQuery(modal).off('shown.bs.modal').on('shown.bs.modal', shownHandler);
        } else {
            shownHandler();
        }
    }
    function filterTable() {
        var input = document.getElementById('loadSearchInput');
        if (!input) return;
        let filter = input.value.toLowerCase();
        let table = document.getElementById('loadsTable');
        if (!table) return;
        let trs = table.getElementsByTagName('tr');
        for (let i = 1; i < trs.length; i++) {
            trs[i].style.display = (trs[i].textContent || trs[i].innerText).toLowerCase().indexOf(filter) > -1 ? '' : 'none';
        }
    }
    function printPODReceipt(tracking, pickup, dropoff, cargo, vehicle, pin) {
        document.getElementById('podTracking').innerText = tracking;
        document.getElementById('podPickup').innerText = pickup;
        document.getElementById('podDropoff').innerText = dropoff;
        document.getElementById('podCargo').innerText = cargo;
        document.getElementById('podVehicle').innerText = vehicle;
        document.getElementById('podPIN').innerText = pin;
        if (window.jQuery) jQuery('#podModal').modal('show');
    }
    function triggerPODPrint() {
        let printContents = document.getElementById('printablePOD').innerHTML;
        let originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        location.reload();
    }
    function openDeliveryCamera(id) {
        var video = document.getElementById('cam' + id);
        video.style.display = 'block';
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            document.getElementById('file' + id).click();
            return;
        }
        navigator.mediaDevices.getUserMedia({ video: true }).then(function (stream) {
            video.srcObject = stream;
        }).catch(function () {
            document.getElementById('file' + id).click();
        });
    }
    function snapDeliveryPhoto(id) {
        var video = document.getElementById('cam' + id);
        var img = document.getElementById('shot' + id);
        var fileInput = document.getElementById('file' + id);
        if (!video.srcObject) {
            fileInput.click();
            return;
        }
        var canvas = document.createElement('canvas');
        canvas.width = video.videoWidth || 640;
        canvas.height = video.videoHeight || 480;
        canvas.getContext('2d').drawImage(video, 0, 0);
        img.src = canvas.toDataURL('image/jpeg');
        img.style.display = 'block';
        canvas.toBlob(function (blob) {
            var file = new File([blob], 'delivery.jpg', { type: 'image/jpeg' });
            var data = new DataTransfer();
            data.items.add(file);
            fileInput.files = data.files;
        }, 'image/jpeg');
    }
</script>