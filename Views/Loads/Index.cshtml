@model IEnumerable<KeystoneLogistics.Models.Load>
@{
    ViewBag.Title = "Freight Loads Dashboard";
    string userRole = Session["UserRole"]?.ToString() ?? "";
    var availableVehicles = (ViewBag.AvailableVehicles as IEnumerable<KeystoneLogistics.Models.Vehicle>)?.ToList()
                            ?? new List<KeystoneLogistics.Models.Vehicle>();
    var availableDrivers = (ViewBag.AvailableDrivers as IEnumerable<KeystoneLogistics.Models.Driver>)?.ToList()
                           ?? new List<KeystoneLogistics.Models.Driver>();
    var loadList = Model ?? Enumerable.Empty<KeystoneLogistics.Models.Load>();
    int pendingCount = loadList.Count(l => l.WorkStatus == "Pending" || l.Status == "Pending");
    int enRouteCount = loadList.Count(l => l.Status == "En Route" || l.Status == "Dispatched");
    var auditLogs = ViewBag.AuditLogs as IEnumerable<KeystoneLogistics.Models.AuditLog>
                    ?? Enumerable.Empty<KeystoneLogistics.Models.AuditLog>();
}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold"><i class="fa-solid fa-boxes-stacked text-info mr-2"></i>Freight Loads Management</h2>
            <p class="text-muted mb-0">Track, dispatch, and process regional logistics shipments</p>
        </div>
        @if (userRole == "Customer")
        {
            <a href="@Url.Action("Create", "Loads")" class="btn btn-success font-weight-bold shadow-sm">
                <i class="fa-solid fa-plus mr-1"></i> Book New Shipment
            </a>
        }
    </div>
    @if (userRole != "Driver")
    {
        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <div class="card shadow" style="border-left: 5px solid #C47B2D;">
                    <div class="card-body py-3">
                        <div class="text-uppercase small font-weight-bold mb-1">Pending Approvals</div>
                        <div class="h3 mb-0 font-weight-bold">@pendingCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card shadow" style="border-left: 5px solid #2F6F5E;">
                    <div class="card-body py-3">
                        <div class="text-uppercase small font-weight-bold mb-1">Active / En Route Loads</div>
                        <div class="h3 mb-0 font-weight-bold">@enRouteCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card shadow" style="border-left: 5px solid #2F6F5E;">
                    <div class="card-body py-3">
                        <div class="text-uppercase small font-weight-bold mb-1">Registered Drivers</div>
                        <div class="h3 mb-0 font-weight-bold">@availableDrivers.Count</div>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (userRole == "Driver")
    {
        var roadAlerts = auditLogs
            .Where(a => a.Action != null && a.Action.StartsWith("ROAD"))
            .OrderByDescending(a => a.Timestamp)
            .Take(5)
            .ToList();
        if (roadAlerts.Any())
        {
            <div class="alert alert-warning shadow-sm">
                <strong>Live road updates</strong>
                @foreach (var alert in roadAlerts)
                {
                    <div>@(alert.Timestamp.HasValue ? alert.Timestamp.Value.ToString("HH:mm") : "") — @alert.PerformedBy: @alert.Action</div>
                }
            </div>
        }
        var lastDelivered = loadList
            .Where(l => l.Status == "Delivered" || l.Status == "Paid / Processing" || l.Status == "Completed")
            .OrderByDescending(l => l.DeliveredDate)
            .FirstOrDefault();
        var returnLog = lastDelivered == null
            ? null
            : auditLogs.FirstOrDefault(a => a.LoadId == lastDelivered.LoadId && a.Action != null && a.Action.StartsWith("RETURN"));
        <div class="card shadow-sm mb-3" style="border-left: 5px solid #2F6F5E;">
            <div class="card-body py-3 d-flex justify-content-between align-items-center flex-wrap">
                <div class="mr-3">
                    <div class="font-weight-bold">Back at base</div>
                    @if (lastDelivered == null)
                    {
                        <div class="small text-muted">Finish a drop-off first. Then tap once when you are back.</div>
                    }
                    else if (returnLog == null)
                    {
                        <div class="small text-muted">Last drop-off @lastDelivered.TrackingNumber. Tap once when you are back.</div>
                    }
                    else
                    {
                        <div class="small text-muted">Return logged for @lastDelivered.TrackingNumber at @(returnLog.Timestamp.HasValue ? returnLog.Timestamp.Value.ToString("HH:mm") : "").</div>
                    }
                </div>
                @if (lastDelivered != null && returnLog == null)
                {
                    using (Html.BeginForm("CheckIn", "Loads", FormMethod.Post, new { @class = "mb-0" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success">I'm back. Log return</button>
                    }
                }
                else if (returnLog != null)
                {
                    <span class="badge badge-success p-2">RETURN @(returnLog.Timestamp.HasValue ? returnLog.Timestamp.Value.ToString("HH:mm") : "")</span>
                }
            </div>
        </div>
        <div class="row">
            @if (!loadList.Any())
            {
                <div class="col-12">
                    <div class="card shadow p-4 text-center text-muted">No active jobs assigned.</div>
                </div>
            }
            else
            {
                foreach (var item in loadList)
                {
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card shadow h-100" style="border-top: 4px solid #2F6F5E;">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="font-weight-bold mb-0">@item.TrackingNumber</h5>
                                    <span class="badge badge-info">@item.Status</span>
                                </div>
                                <div class="small text-muted mb-1"><i class="fa-solid fa-location-dot mr-1"></i>@item.PickupLocation</div>
                                <div class="small text-muted mb-3"><i class="fa-solid fa-flag-checkered mr-1"></i>@item.DropoffLocation</div>
                                <div class="small mb-3">
                                    <strong>Cargo:</strong> @item.CargoDescription
                                    @if ((item.CargoDescription ?? "").IndexOf("fragile", StringComparison.OrdinalIgnoreCase) >= 0)
                                    {
                                        <span class="badge badge-warning ml-1">FRAGILE</span>
                                    }
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-info mb-3"
                                        onclick="openMapModal('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.Status')">
                                    Live Route
                                </button>
                                <div class="small font-weight-bold mb-2">Road update. Tap only. No typing.</div>
                                <div class="d-flex flex-wrap mb-3">
                                    @using (Html.BeginForm("RoadAlert", "Loads", FormMethod.Post, new { @class = "mr-1 mb-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.LoadId" />
                                        <input type="hidden" name="alertType" value="traffic" />
                                        <button type="submit" class="btn btn-sm btn-warning">Heavy traffic</button>
                                    }
                                    @using (Html.BeginForm("RoadAlert", "Loads", FormMethod.Post, new { @class = "mr-1 mb-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.LoadId" />
                                        <input type="hidden" name="alertType" value="blocked" />
                                        <button type="submit" class="btn btn-sm btn-danger">Road blocked</button>
                                    }
                                    @using (Html.BeginForm("RoadAlert", "Loads", FormMethod.Post, new { @class = "mr-1 mb-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.LoadId" />
                                        <input type="hidden" name="alertType" value="construction" />
                                        <button type="submit" class="btn btn-sm btn-secondary">Construction</button>
                                    }
                                    @using (Html.BeginForm("RoadAlert", "Loads", FormMethod.Post, new { @class = "mr-1 mb-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.LoadId" />
                                        <input type="hidden" name="alertType" value="risk" />
                                        <button type="submit" class="btn btn-sm btn-dark">High-risk area</button>
                                    }
                                </div>
                                @if (item.Status == "Dispatched" && !(item.IsCollected ?? false))
                                {
                                    using (Html.BeginForm("VerifyCollection", "Loads", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.LoadId" />
                                        <label class="small font-weight-bold">Package photo at pickup</label>
                                        <video id="pcam@(item.LoadId)" autoplay playsinline style="width:100%; border-radius:8px; background:#111; display:none;"></video>
                                        <img id="pshot@(item.LoadId)" alt="Pickup photo" style="width:100%; border-radius:8px; display:none; margin-bottom:8px;" />
                                        <input type="file" name="pickupPhoto" id="pfile@(item.LoadId)" accept="image/*" capture="environment" class="d-none" required />
                                        <button type="button" class="btn btn-outline-secondary btn-block mb-1" onclick="openPickupCamera(@item.LoadId)">Open camera</button>
                                        <button type="button" class="btn btn-outline-success btn-block mb-2" onclick="snapPickupPhoto(@item.LoadId)">Snap package photo</button>
                                        <label class="small font-weight-bold">Actual weight at pickup (kg)</label>
                                        <input type="number" name="actualWeightKg" class="form-control form-control-lg mb-2 text-center" placeholder="e.g. 45" step="0.1" min="0.1" required style="font-size:1.2rem;" />
                                        <small class="form-text text-muted mb-2">Weigh the package. R1.50 per kg is added to the customer invoice.</small>
                                        <input type="text" name="enteredPasscode" class="form-control form-control-lg mb-2 text-center" placeholder="4-Digit PIN" required style="font-size:1.4rem; letter-spacing:4px;" />
                                        <button type="submit" class="btn btn-primary btn-lg btn-block">Verify Pickup</button>
                                    }
                                }
                                else if ((item.IsCollected ?? false) && item.Status != "Delivered" && item.Status != "Paid / Processing" && item.Status != "Completed")
                                {
                                    <button type="button" class="btn btn-success btn-lg btn-block" data-toggle="modal" data-target="#deliveryModal@(item.LoadId)">Confirm Delivery</button>
                                }
                                else if (item.Status == "Delivered" || item.Status == "Completed")
                                {
                                    <span class="badge badge-success p-2">Job Completed</span>
                                }
                                else if (item.Status == "Queued")
                                {
                                    <span class="badge badge-warning p-2">Queued — wait for current job to finish</span>
                                }
                                else
                                {
                                    <span class="small text-muted">Waiting for dispatch...</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="card shadow mb-5">
            <div class="card-header d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 font-weight-bold">Shipment Records</h5>
                <input type="text" id="loadSearchInput" class="form-control form-control-sm" style="width:300px;" placeholder="Search shipments..." onkeyup="filterTable()" />
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="loadsTable">
                        <thead>
                            <tr>
                                <th>Tracking #</th>
                                <th>Route</th>
                                <th>Cargo</th>
                                <th>Status</th>
                                <th>Assigned Driver / Vehicle</th>
                                <th>Collection PIN</th>
                                <th class="text-center">Workflow Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!loadList.Any())
                            {
                                <tr><td colspan="7" class="text-center py-4">No freight shipments found.</td></tr>
                            }
                            else
                            {
                                foreach (var item in loadList)
                                {
                                    DateTime? due = item.DeliveredDate.HasValue ? item.DeliveredDate.Value.AddDays(3) : (DateTime?)null;
                                    bool overdue = item.Status == "Delivered" && due.HasValue && due.Value < DateTime.Now;
                                    <tr>
                                        <td><strong>@item.TrackingNumber</strong></td>
                                        <td>
                                            <div class="small"><strong>From:</strong> @item.PickupLocation</div>
                                            <div class="small mb-1"><strong>To:</strong> @item.DropoffLocation</div>
                                            <button type="button" class="btn btn-sm btn-outline-info mt-1"
                                                    onclick="openMapModal('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.Status')">
                                                Live Route
                                            </button>
                                        </td>
                                        <td>
                                            @item.CargoDescription
                                            @if ((item.CargoDescription ?? "").IndexOf("fragile", StringComparison.OrdinalIgnoreCase) >= 0)
                                            {
                                                <div class="badge badge-warning mt-1">FRAGILE — handle with care</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge badge-secondary">@item.Status</span>
                                            @if (overdue)
                                            {
                                                <div class="badge badge-danger mt-1">PAYMENT OVERDUE</div>
                                            }
                                        </td>
                                        <td>
                                            @if (item.Driver != null)
                                            {
                                                <div><strong>@item.Driver.FullName</strong></div>
                                                <div class="small">@(item.Driver.VehicleRegistration ?? "")</div>
                                            }
                                            else
                                            {
                                                <span>Unassigned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (userRole == "Admin" || userRole == "Customer")
                                            {
                                                <code>@(item.CollectionPasscode ?? "N/A")</code>
                                            }
                                            else
                                            {
                                                <span class="small">(Customer Provided)</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (userRole == "Admin" && (item.WorkStatus == "Pending" || item.Status == "Pending"))
                                            {
                                                using (Html.BeginForm("AcceptRequest", "Loads", FormMethod.Post, new { @class = "mb-2" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.LoadId" />
                                                    <select name="driverId" class="form-control form-control-sm mb-1" required>
                                                        <option value="">-- Assign Driver --</option>
                                                        @foreach (var driver in availableDrivers)
                                                        {
                                                            <option value="@driver.DriverId">@driver.FullName — @driver.VehicleRegistration</option>
                                                        }
                                                    </select>
                                                    <select name="routeSafety" class="form-control form-control-sm mb-1">
                                                        <option value="Safe">Safe Route</option>
                                                        <option value="Caution">Caution Required</option>
                                                        <option value="High Risk">High Risk</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-success btn-block">Accept & Email</button>
                                                }
                                                using (Html.BeginForm("RejectRequest", "Loads", FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.LoadId" />
                                                    <select name="rejectionReason" class="form-control form-control-sm mb-1" required>
                                                        <option value="">-- Select Reason --</option>
                                                        <option value="Location is too far">Location is too far</option>
                                                        <option value="Route is too dangerous">Route is too dangerous</option>
                                                        <option value="Invalid cargo specifications">Invalid cargo specifications</option>
                                                        <option value="Vehicle capacity exceeded">Vehicle capacity exceeded</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-outline-danger btn-block">Reject</button>
                                                }
                                            }
                                            else if (userRole == "Admin" && item.Status == "Paid / Processing")
                                            {
                                                <a href="@Url.Action("DriverCheckout", "Payment", new { id = item.LoadId })" class="btn btn-sm btn-success">Pay Driver</a>
                                            }
                                            else if (userRole == "Customer" && item.Status == "Delivered")
                                            {
                                                if (overdue)
                                                {
                                                    <div class="small font-weight-bold text-danger mb-1">FINAL DEMAND. Pay now or this account goes to collections.</div>
                                                }
                                                else if (due.HasValue)
                                                {
                                                    <div class="small font-weight-bold mb-1">Pay by @due.Value.ToString("dd MMM yyyy")</div>
                                                }
                                                <a href="@Url.Action("Checkout", "Payment", new { id = item.LoadId })" class="btn btn-sm btn-success mb-1">Pay Now</a>
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        onclick="printPODReceipt('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.CargoDescription', 'Vehicle #@item.AssignedVehicleId', '@(item.CollectionPasscode ?? "N/A")')">
                                                    POD Receipt
                                                </button>
                                            }
                                            else if (item.Status == "Delivered")
                                            {
                                                if (overdue)
                                                {
                                                    <div class="small font-weight-bold text-danger mb-1">Customer payment overdue</div>
                                                }
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        onclick="printPODReceipt('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.CargoDescription', 'Vehicle #@item.AssignedVehicleId', '@(item.CollectionPasscode ?? "N/A")')">
                                                    POD Receipt
                                                </button>
                                            }
                                            else if (item.Status == "Completed")
                                            {
                                                <span class="small">Job Fully Completed</span>
                                            }
                                            else
                                            {
                                                <span class="small">No action required</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    @if (userRole == "Admin")
    {
        var all = loadList.ToList();
        int totalJobs = all.Count;
        int pendingJobs = all.Count(l => l.Status == "Pending" || l.WorkStatus == "Pending");
        int queuedJobs = all.Count(l => l.Status == "Queued");
        int activeJobs = all.Count(l => l.Status == "Dispatched" || l.Status == "En Route");
        int deliveredJobs = all.Count(l => l.Status == "Delivered");
        int paidJobs = all.Count(l => l.Status == "Paid / Processing");
        int completedJobs = all.Count(l => l.Status == "Completed" || l.WorkStatus == "Completed");
        int rejectedJobs = all.Count(l => l.Status == "Cancelled" || l.WorkStatus == "Rejected");
        int decidedJobs = completedJobs + rejectedJobs;
        decimal completionRate = decidedJobs == 0 ? 0 : Math.Round((decimal)completedJobs / decidedJobs * 100, 1);
        decimal rejectRate = decidedJobs == 0 ? 0 : Math.Round((decimal)rejectedJobs / decidedJobs * 100, 1);
        int unassignedJobs = all.Count(l => l.DriverId == null && l.Status != "Cancelled");
        int overdueJobs = all.Count(l => l.Status == "Delivered" && l.DeliveredDate.HasValue && l.DeliveredDate.Value.AddDays(3) < DateTime.Now);
        decimal earned = all.Where(l => l.Status == "Paid / Processing" || l.Status == "Completed").Sum(l => l.QuotedAmount);
        decimal customersOwe = all.Where(l => l.Status == "Delivered").Sum(l => l.QuotedAmount);
        decimal owedToDrivers = all.Where(l => l.Status == "Paid / Processing").Sum(l => l.DriverCut);
        decimal paidToDrivers = all.Where(l => l.Status == "Completed").Sum(l => l.DriverCut);
        decimal grossProfit = earned - paidToDrivers;
        decimal net = earned - paidToDrivers - owedToDrivers;
        decimal billed = earned + customersOwe;
        decimal margin = earned == 0 ? 0 : Math.Round(grossProfit / earned * 100, 1);
        decimal collectionRate = billed == 0 ? 0 : Math.Round(earned / billed * 100, 1);
        int paidCount = all.Count(l => l.Status == "Paid / Processing" || l.Status == "Completed");
        decimal avgTicket = paidCount == 0 ? 0 : Math.Round(earned / paidCount, 0);
        var monthStart = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        var monthLoads = all.Where(l => (l.Status == "Paid / Processing" || l.Status == "Completed") && l.DeliveredDate.HasValue && l.DeliveredDate.Value >= monthStart).ToList();
        decimal monthRevenue = monthLoads.Sum(l => l.QuotedAmount);
        decimal monthDriverSpend = monthLoads.Sum(l => l.DriverCut);
        decimal monthProfit = monthRevenue - monthDriverSpend;
        int companyCount = all.Where(l => l.Customer != null).Select(l => l.CustomerId).Distinct().Count();
        decimal health = Math.Max(0, Math.Min(100, Math.Round(collectionRate - (overdueJobs * 4) - (rejectRate / 2), 0)));
        var driverRows = all.Where(l => l.Driver != null)
            .GroupBy(l => l.Driver.FullName)
            .Select(g => new
            {
                Name = g.Key,
                Jobs = g.Count(),
                Done = g.Count(x => x.Status == "Completed" || x.Status == "Delivered" || x.Status == "Paid / Processing"),
                Owed = g.Where(x => x.Status == "Paid / Processing").Sum(x => x.DriverCut),
                Paid = g.Where(x => x.Status == "Completed").Sum(x => x.DriverCut)
            })
            .OrderByDescending(x => x.Paid + x.Owed)
            .Take(5)
            .ToList();
        var customerRows = all.Where(l => l.Customer != null)
            .GroupBy(l => string.IsNullOrWhiteSpace(l.Customer.CompanyName) ? l.Customer.ContactPerson : l.Customer.CompanyName)
            .Select(g => new
            {
                Name = g.Key,
                Jobs = g.Count(),
                Owes = g.Where(x => x.Status == "Delivered").Sum(x => x.QuotedAmount),
                Paid = g.Where(x => x.Status == "Paid / Processing" || x.Status == "Completed").Sum(x => x.QuotedAmount)
            })
            .OrderByDescending(x => x.Paid)
            .Take(5)
            .ToList();
        <div class="card shadow mb-5" style="border-radius: 16px; overflow: hidden;">
            <div class="card-header py-3" style="background: #3A3226; color: #F4EFE6;">
                <h5 class="mb-0 font-weight-bold"><i class="fa-solid fa-chart-column mr-2"></i>Dispatch Analytics</h5>
                <small style="color:#EBE3D4;">Live figures from the shipment records above. Money uses the same fee rules as checkout.</small>
            </div>
            <div class="card-body">
                <div class="row text-center mb-3">
                    <div class="col-6 col-md-2 mb-3"><div class="p-3" style="background:#C47B2D;border-radius:12px;"><div class="h3 mb-0" style="color:#1A140E;font-weight:800;">@pendingJobs</div><div style="color:#1A140E;font-weight:700;font-size:13px;">Waiting on admin</div></div></div>
                    <div class="col-6 col-md-2 mb-3"><div class="p-3" style="background:#2F6F5E;border-radius:12px;"><div class="h3 mb-0" style="color:#1A140E;font-weight:800;">@activeJobs</div><div style="color:#1A140E;font-weight:700;font-size:13px;">On the road</div></div></div>
                    <div class="col-6 col-md-2 mb-3"><div class="p-3" style="background:#3D6F8F;border-radius:12px;"><div class="h3 mb-0" style="color:#1A140E;font-weight:800;">@queuedJobs</div><div style="color:#1A140E;font-weight:700;font-size:13px;">Queued behind a job</div></div></div>
                    <div class="col-6 col-md-2 mb-3"><div class="p-3" style="background:#B45309;border-radius:12px;"><div class="h3 mb-0" style="color:#1A140E;font-weight:800;">@deliveredJobs</div><div style="color:#1A140E;font-weight:700;font-size:13px;">Awaiting payment</div></div></div>
