@model IEnumerable<KeystoneLogistics.Models.Load>

@{
    ViewBag.Title = "Freight Loads Dashboard";
    string userRole = Session["UserRole"]?.ToString() ?? "";
    var availableVehicles = ViewBag.AvailableVehicles as List<KeystoneLogistics.Models.Vehicle> ?? new List<KeystoneLogistics.Models.Vehicle>();
    var loadList = Model ?? Enumerable.Empty<KeystoneLogistics.Models.Load>();

    int pendingCount = loadList.Count(l => l.WorkStatus == "Pending" || l.Status == "Pending");
    int enRouteCount = loadList.Count(l => l.Status == "En Route" || l.Status == "Dispatched");
    int availableVehiclesCount = availableVehicles.Count;
}

<!-- Leaflet.js Map Assets -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="page-heading"><i class="fa-solid fa-boxes-stacked text-info mr-2"></i>Freight Loads Management</h2>
            <p class="page-subtitle">Track, dispatch, and process regional logistics shipments</p>
        </div>
        @if (userRole == "Customer")
        {
            <a href="@Url.Action("Create", "Loads")" class="btn btn-success font-weight-bold shadow-sm">
                <i class="fa-solid fa-plus mr-1"></i> Book New Shipment
            </a>
        }
    </div>

    <!-- Summary Metrics Dashboard Cards -->
    <div class="row mb-4">
        <div class="col-md-4 mb-2">
            <div class="card border-left-warning shadow h-100 py-2 bg-dark text-white border-warning" style="border-left: 5px solid #ffc107;">
                <div class="card-body py-2">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Pending Approvals</div>
                            <div class="h3 mb-0 font-weight-bold text-white">@pendingCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-solid fa-clock fa-2x text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-2">
            <div class="card border-left-info shadow h-100 py-2 bg-dark text-white border-info" style="border-left: 5px solid #17a2b8;">
                <div class="card-body py-2">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Active / En Route Loads</div>
                            <div class="h3 mb-0 font-weight-bold text-white">@enRouteCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-solid fa-truck-fast fa-2x text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-2">
            <div class="card border-left-success shadow h-100 py-2 bg-dark text-white border-success" style="border-left: 5px solid #28a745;">
                <div class="card-body py-2">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Available Fleet Vehicles</div>
                            <div class="h3 mb-0 font-weight-bold text-white">@availableVehiclesCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fa-solid fa-van-shuttle fa-2x text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Banners -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check mr-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation mr-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Main Data Table -->
    <div class="data-card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 font-weight-bold"><i class="fa-solid fa-table-list mr-2 text-info"></i>Shipment Records</h5>
            <div class="input-group" style="width: 300px;">
                <div class="input-group-prepend">
                    <span class="input-group-text bg-secondary text-white border-secondary"><i class="fa-solid fa-search"></i></span>
                </div>
                <input type="text" id="loadSearchInput" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Search shipments..." onkeyup="filterTable()" />
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="loadsTable">
                <thead class="thead-dark">
                    <tr>
                        <th>Tracking #</th>
                        <th>Route</th>
                        <th>Cargo</th>
                        <th>Status</th>
                        <th>Assigned Vehicle</th>
                        <th>Collection PIN</th>
                        <th class="text-center">Workflow Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!loadList.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-folder-open fa-2x mb-2 d-block"></i>
                                No freight shipments found in the system.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in loadList)
                        {
                            <tr>
                                <td>
                                    <strong>@item.TrackingNumber</strong>
                                </td>
                                <td>
                                    <div class="small"><strong>From:</strong> @item.PickupLocation</div>
                                    <div class="small text-muted mb-1"><strong>To:</strong> @item.DropoffLocation</div>
                                    <button type="button" class="btn btn-sm btn-outline-info"
                                            onclick="openMapModal('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.Status')">
                                        <i class="fa-solid fa-map-location-dot mr-1"></i> Live Route
                                    </button>
                                </td>
                                <td>@item.CargoDescription</td>
                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge badge-warning text-dark">Pending Admin</span>
                                    }
                                    else if (item.Status == "Dispatched")
                                    {
                                        <span class="badge badge-info">Dispatched</span>
                                    }
                                    else if (item.Status == "En Route")
                                    {
                                        <span class="badge badge-primary">En Route</span>
                                    }
                                    else if (item.Status == "Delivered")
                                    {
                                        <span class="badge badge-success">Delivered</span>
                                    }
                                    else if (item.Status == "Cancelled" || item.Status == "Rejected")
                                    {
                                        <span class="badge badge-danger">Rejected</span>
                                        if (!string.IsNullOrEmpty(item.RejectionReason))
                                        {
                                            <br /><small class="text-muted">Reason: @item.RejectionReason</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    @(item.AssignedVehicleId != null ? $"Vehicle #{item.AssignedVehicleId}" : "Unassigned")
                                </td>
                                <td>
                                    @if (userRole == "Admin" || userRole == "Customer")
                                    {
                                        <code class="h6 font-weight-bold text-primary">@(item.CollectionPasscode ?? "N/A")</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><em>(Customer Provided)</em></span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (userRole == "Admin" && (item.WorkStatus == "Pending" || item.Status == "Pending"))
                                    {
                                        using (Html.BeginForm("AcceptRequest", "Loads", FormMethod.Post, new { @class = "mb-2" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.LoadId" />

                                            <div class="form-group mb-1">
                                                <select name="vehicleId" class="form-control form-control-sm" required>
                                                    <option value="">-- Assign Vehicle --</option>
                                                    @foreach (var v in availableVehicles)
                                                    {
                                                        <option value="@v.VehicleId">Vehicle #@v.VehicleId (@v.CapacityKg kg)</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="form-group mb-1">
                                                <select name="routeSafety" class="form-control form-control-sm">
                                                    <option value="Safe">Safe Route</option>
                                                    <option value="Caution">Caution Required</option>
                                                    <option value="High Risk">High Risk</option>
                                                </select>
                                            </div>

                                            <button type="submit" class="btn btn-sm btn-success btn-block font-weight-bold">Accept & Email</button>
                                        }

                                        using (Html.BeginForm("RejectRequest", "Loads", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.LoadId" />

                                            <div class="form-group mb-1">
                                                <select name="rejectionReason" class="form-control form-control-sm" required>
                                                    <option value="">-- Select Reason --</option>
                                                    <option value="Location is too far">Location is too far</option>
                                                    <option value="Route is too dangerous">Route is too dangerous</option>
                                                    <option value="Invalid cargo specifications">Invalid cargo specifications</option>
                                                    <option value="Vehicle capacity exceeded">Vehicle capacity exceeded</option>
                                                </select>
                                            </div>

                                            <button type="submit" class="btn btn-sm btn-outline-danger btn-block">Reject</button>
                                        }
                                    }
                                    else if (userRole == "Driver" && item.Status == "Dispatched" && !(item.IsCollected ?? false))
                                    {
                                        using (Html.BeginForm("VerifyCollection", "Loads", FormMethod.Post, new { @class = "form-inline d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.LoadId" />
                                            <input type="text" name="enteredPasscode" class="form-control form-control-sm mr-1" placeholder="4-Digit PIN" style="width: 100px;" required />
                                            <button type="submit" class="btn btn-sm btn-primary">Verify Pickup</button>
                                        }
                                    }
                                    else if (userRole == "Driver" && (item.IsCollected ?? false) && item.Status != "Delivered")
                                    {
                                        <button type="button" class="btn btn-sm btn-success" data-toggle="modal" data-target="#deliveryModal@(item.LoadId)">
                                            <i class="fa-solid fa-clipboard-check mr-1"></i> Confirm Delivery
                                        </button>
                                    }
                                    else if (item.Status == "Delivered")
                                    {
                                        <span class="text-success font-weight-bold d-block mb-1"><i class="fa-solid fa-circle-check"></i> Complete</span>
                                        <button type="button" class="btn btn-sm btn-outline-dark"
                                                onclick="printPODReceipt('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.CargoDescription', 'Vehicle #@item.AssignedVehicleId', '@(item.CollectionPasscode ?? "N/A")')">
                                            <i class="fa-solid fa-file-pdf text-danger mr-1"></i> POD Receipt
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No action required</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Admin Audit Trail Section -->
    @if (userRole == "Admin" && ViewBag.AuditLogs != null)
    {
        var auditLogs = ViewBag.AuditLogs as System.Collections.IEnumerable;
        if (auditLogs != null)
        {
            <div class="card mt-5 shadow-sm p-4 bg-dark text-white border-secondary mb-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h4 mb-0"><i class="fa-solid fa-clipboard-list text-warning mr-2"></i>System Audit Trail & History</h3>
                    <span class="text-muted small">Automatic activity log (Admin View Only)</span>
                </div>
                <hr class="border-secondary" />

                <div class="table-responsive">
                    <table class="table table-dark table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Audit ID</th>
                                <th>Load ID</th>
                                <th>Action Performed</th>
                                <th>Performed By</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in auditLogs)
                            {
                                var dynLog = log as dynamic;
                                <tr>
                                    <td>@dynLog.AuditId</td>
                                    <td><span class="badge badge-secondary">#@dynLog.LoadId</span></td>
                                    <td><strong>@dynLog.Action</strong></td>
                                    <td>@dynLog.PerformedBy</td>
                                    <td>@dynLog.Timestamp</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

<!-- Delivery Confirmation Modals for Drivers -->
@foreach (var item in loadList)
{
    if (userRole == "Driver" && (item.IsCollected ?? false) && item.Status != "Delivered")
    {
        <div class="modal fade" id="deliveryModal@(item.LoadId)" tabindex="-1" role="dialog" aria-hidden="true" data-load-id="@item.LoadId">
            <div class="modal-dialog modal-md modal-dialog-centered" role="document">
                <div class="modal-content bg-dark text-white border-secondary">
                    @using (Html.BeginForm("MarkDelivered", "Loads", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.LoadId" />
                        <div class="modal-header border-bottom border-secondary">
                            <h5 class="modal-title font-weight-bold">
                                <i class="fa-solid fa-clipboard-check mr-2 text-success"></i>Confirm Delivery (@item.TrackingNumber)
                            </h5>
                            <button type="button" class="close text-white closeModalBtn" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <div class="form-group">
                                <label class="small text-muted">Tracking Number / Confirmation Reference</label>
                                <input type="text" id="scannedInput-@(item.LoadId)" name="scannedQRCode" class="form-control bg-dark text-white border-secondary" placeholder="e.g. @item.TrackingNumber" required />
                            </div>
                        </div>
                        <div class="modal-footer border-top border-secondary">
                            <button type="button" class="btn btn-secondary btn-sm closeModalBtn" data-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success btn-sm font-weight-bold">Confirm Delivery</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

<!-- Tracking Map Modal -->
<div class="modal fade" id="trackingMapModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title font-weight-bold" id="mapModalTitle">
                    <i class="fa-solid fa-route mr-2 text-info"></i>Shipment Tracking
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0 position-relative">
                <div id="geocodingStatus" class="p-2 text-center text-muted small bg-light d-none">
                    <i class="fa-solid fa-spinner fa-spin mr-1"></i> Resolving dynamic coordinates via OpenStreetMap...
                </div>
                <div id="leafletMap" style="height: 420px; width: 100%;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Printable POD Receipt Modal -->
<div class="modal fade" id="podModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content text-dark">
            <div id="printablePOD" class="modal-body p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                    <div>
                        <h4 class="font-weight-bold text-primary mb-0"><i class="fa-solid fa-truck-fast mr-2"></i>KEYSTONE LOGISTICS</h4>
                        <small class="text-muted">Official Proof of Delivery (POD) Manifest</small>
                    </div>
                    <div class="text-right">
                        <span class="badge badge-success px-3 py-2 font-weight-bold">DELIVERED</span>
                    </div>
                </div>

                <table class="table table-bordered table-sm mb-3">
                    <tbody>
                        <tr>
                            <th class="bg-light" style="width: 40%;">Tracking Number</th>
                            <td id="podTracking" class="font-weight-bold text-primary"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Pickup Origin</th>
                            <td id="podPickup"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Dropoff Destination</th>
                            <td id="podDropoff"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Cargo Description</th>
                            <td id="podCargo"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Assigned Fleet</th>
                            <td id="podVehicle"></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Verification PIN</th>
                            <td id="podPIN" class="font-weight-bold"></td>
                        </tr>
                    </tbody>
                </table>

                <div class="border-top pt-3 text-center text-muted small">
                    <i class="fa-solid fa-shield-halved text-success mr-1"></i> Verified Electronic Signature & Clearance Approval
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger font-weight-bold" onclick="triggerPODPrint()">
                    <i class="fa-solid fa-print mr-1"></i> Print / Save PDF
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let map = null;
    let animationInterval = null;

    function lerp(start, end, t) {
        return start + (end - start) * t;
    }

    async function geocodeAddress(address) {
        try {
            const query = address.toLowerCase().includes('south africa') ? address : `${address}, South Africa`;
            const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`);
            const data = await response.json();
            if (data && data.length > 0) {
                return [parseFloat(data[0].lat), parseFloat(data[0].lon)];
            }
        } catch (err) {
            console.warn('Geocoding fallback triggered for:', address);
        }
        return null;
    }

    function openMapModal(trackingNum, pickup, dropoff, status) {
        $('#mapModalTitle').html(`<i class="fa-solid fa-route mr-2 text-info"></i> Shipment Tracking (${trackingNum}) - <span class="badge badge-light">${status}</span>`);
        $('#trackingMapModal').modal('show');

        if (animationInterval) clearInterval(animationInterval);

        $('#trackingMapModal').off('shown.bs.modal').on('shown.bs.modal', async function () {
            if (map !== null) {
                map.remove();
            }

            $('#geocodingStatus').removeClass('d-none');

            map = L.map('leafletMap').setView([-29.8587, 31.0218], 9);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            let pickupCoords = await geocodeAddress(pickup) || [-29.8732, 31.0253];
            let dropoffCoords = await geocodeAddress(dropoff) || [-29.6006, 30.3794];

            $('#geocodingStatus').addClass('d-none');

            L.marker(pickupCoords).addTo(map).bindPopup(`<b>Pickup:</b> ${pickup}`);
            L.marker(dropoffCoords).addTo(map).bindPopup(`<b>Destination:</b> ${dropoff}`);

            let vehicleMarker = L.marker(pickupCoords).addTo(map).bindPopup(`<b>Tracking:</b> ${trackingNum} <br/> <b>Status:</b> ${status}`);

            const routeLine = L.polyline([pickupCoords, dropoffCoords], {
                color: '#17a2b8',
                weight: 4,
                opacity: 0.8,
                dashArray: '8, 8'
            }).addTo(map);

            map.fitBounds(routeLine.getBounds(), { padding: [50, 50] });
            map.invalidateSize();

            if (status === "En Route") {
                let t = 0;
                let step = 0.0004;
                animationInterval = setInterval(() => {
                    t += step;
                    if (t > 1 || t < 0) step = -step;
                    let currentLat = lerp(pickupCoords[0], dropoffCoords[0], t);
                    let currentLng = lerp(pickupCoords[1], dropoffCoords[1], t);
                    vehicleMarker.setLatLng([currentLat, currentLng]);
                }, 50);
            }
        });
    }

    function printPODReceipt(tracking, pickup, dropoff, cargo, vehicle, pin) {
        $('#podTracking').text(tracking);
        $('#podPickup').text(pickup);
        $('#podDropoff').text(dropoff);
        $('#podCargo').text(cargo);
        $('#podVehicle').text(vehicle);
        $('#podPIN').text(pin);
        $('#podModal').modal('show');
    }

    function triggerPODPrint() {
        const printContents = document.getElementById('printablePOD').innerHTML;
        const originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        window.location.reload();
    }

    // --- Table Live Search Filter ---
    function filterTable() {
        let input = document.getElementById("loadSearchInput");
        let filter = input.value.toLowerCase();
        let table = document.getElementById("loadsTable");
        let tr = table.getElementsByTagName("tr");

        for (let i = 1; i < tr.length; i++) {
            let tdText = tr[i].textContent || tr[i].innerText;
            if (tdText.toLowerCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>