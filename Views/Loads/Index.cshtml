@model IEnumerable<KeystoneLogistics.Models.Load>
@{
    ViewBag.Title = "Freight Loads Dashboard";
    string userRole = Session["UserRole"]?.ToString() ?? "";
    var availableVehicles = (ViewBag.AvailableVehicles as IEnumerable<KeystoneLogistics.Models.Vehicle>)?.ToList()
                            ?? new List<KeystoneLogistics.Models.Vehicle>();
    var availableDrivers = (ViewBag.AvailableDrivers as IEnumerable<KeystoneLogistics.Models.Driver>)?.ToList()
                           ?? new List<KeystoneLogistics.Models.Driver>();
    var loadList = Model ?? Enumerable.Empty<KeystoneLogistics.Models.Load>();
    int pendingCount = loadList.Count(l => l.WorkStatus == "Pending" || l.Status == "Pending");
    int enRouteCount = loadList.Count(l => l.Status == "En Route" || l.Status == "Dispatched");
    var auditLogs = ViewBag.AuditLogs as IEnumerable<KeystoneLogistics.Models.AuditLog>
                    ?? Enumerable.Empty<KeystoneLogistics.Models.AuditLog>();
}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold"><i class="fa-solid fa-boxes-stacked text-info mr-2"></i>Freight Loads Management</h2>
            <p class="text-muted mb-0">Track, dispatch, and process regional logistics shipments</p>
        </div>
        @if (userRole == "Customer")
        {
            <a href="@Url.Action("Create", "Loads")" class="btn btn-success font-weight-bold shadow-sm">
                <i class="fa-solid fa-plus mr-1"></i> Book New Shipment
            </a>
        }
    </div>

    @if (userRole != "Driver")
    {
        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <div class="card shadow" style="border-left: 5px solid #C47B2D;">
                    <div class="card-body py-3">
                        <div class="text-uppercase small font-weight-bold mb-1">Pending Approvals</div>
                        <div class="h3 mb-0 font-weight-bold">@pendingCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card shadow" style="border-left: 5px solid #2F6F5E;">
                    <div class="card-body py-3">
                        <div class="text-uppercase small font-weight-bold mb-1">Active / En Route Loads</div>
                        <div class="h3 mb-0 font-weight-bold">@enRouteCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card shadow" style="border-left: 5px solid #2F6F5E;">
                    <div class="card-body py-3">
                        <div class="text-uppercase small font-weight-bold mb-1">Registered Drivers</div>
                        <div class="h3 mb-0 font-weight-bold">@availableDrivers.Count</div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    @if (userRole == "Driver")
    {
        <div class="row">
            @if (!loadList.Any())
            {
                <div class="col-12">
                    <div class="card shadow p-4 text-center text-muted">No active jobs assigned.</div>
                </div>
            }
            else
            {
                foreach (var item in loadList)
                {
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card shadow h-100" style="border-top: 4px solid #2F6F5E;">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="font-weight-bold mb-0">@item.TrackingNumber</h5>
                                    <span class="badge badge-info">@item.Status</span>
                                </div>
                                <div class="small text-muted mb-1"><i class="fa-solid fa-location-dot mr-1"></i>@item.PickupLocation</div>
                                <div class="small text-muted mb-3"><i class="fa-solid fa-flag-checkered mr-1"></i>@item.DropoffLocation</div>
                                <div class="small mb-3"><strong>Cargo:</strong> @item.CargoDescription</div>
                                <button type="button" class="btn btn-sm btn-outline-info mb-3"
                                        onclick="openMapModal('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.Status')">
                                    Live Route
                                </button>

                                @if (item.Status == "Dispatched" && !(item.IsCollected ?? false))
                                {
                                    using (Html.BeginForm("VerifyCollection", "Loads", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.LoadId" />
                                        <input type="text" name="enteredPasscode" class="form-control form-control-lg mb-2 text-center" placeholder="4-Digit PIN" required style="font-size:1.4rem; letter-spacing:4px;" />
                                        <button type="submit" class="btn btn-primary btn-lg btn-block">Verify Pickup</button>
                                    }
                                }
                                else if ((item.IsCollected ?? false) && item.Status != "Delivered" && item.Status != "Paid / Processing" && item.Status != "Completed")
                                {
                                    <button type="button" class="btn btn-success btn-lg btn-block" data-toggle="modal" data-target="#deliveryModal@(item.LoadId)">Confirm Delivery</button>
                                }
                                else if (item.Status == "Delivered" || item.Status == "Completed")
                                {
                                    <span class="badge badge-success p-2">Job Completed</span>
                                }
                                else if (item.Status == "Queued")
                                {
                                    <span class="badge badge-warning p-2">Queued — wait for current job to finish</span>
                                }
                                else
                                {
                                    <span class="small text-muted">Waiting for dispatch...</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="card shadow mb-5">
            <div class="card-header d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 font-weight-bold">Shipment Records</h5>
                <input type="text" id="loadSearchInput" class="form-control form-control-sm" style="width:300px;" placeholder="Search shipments..." onkeyup="filterTable()" />
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="loadsTable">
                        <thead>
                            <tr>
                                <th>Tracking #</th>
                                <th>Route</th>
                                <th>Cargo</th>
                                <th>Status</th>
                                <th>Assigned Driver / Vehicle</th>
                                <th>Collection PIN</th>
                                <th class="text-center">Workflow Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!loadList.Any())
                            {
                                <tr><td colspan="7" class="text-center py-4">No freight shipments found.</td></tr>
                            }
                            else
                            {
                                foreach (var item in loadList)
                                {
                                    <tr>
                                        <td><strong>@item.TrackingNumber</strong></td>
                                        <td>
                                            <div class="small"><strong>From:</strong> @item.PickupLocation</div>
                                            <div class="small mb-1"><strong>To:</strong> @item.DropoffLocation</div>
                                            <button type="button" class="btn btn-sm btn-outline-info mt-1"
                                                    onclick="openMapModal('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.Status')">
                                                Live Route
                                            </button>
                                        </td>
                                        <td>@item.CargoDescription</td>
                                        <td><span class="badge badge-secondary">@item.Status</span></td>
                                        <td>
                                            @if (item.Driver != null)
                                            {
                                                <div><strong>@item.Driver.FullName</strong></div>
                                                <div class="small">@(item.Driver.VehicleRegistration ?? "")</div>
                                            }
                                            else
                                            {
                                                <span>Unassigned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (userRole == "Admin" || userRole == "Customer")
                                            {
                                                <code>@(item.CollectionPasscode ?? "N/A")</code>
                                            }
                                            else
                                            {
                                                <span class="small">(Customer Provided)</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (userRole == "Admin" && (item.WorkStatus == "Pending" || item.Status == "Pending"))
                                            {
                                                using (Html.BeginForm("AcceptRequest", "Loads", FormMethod.Post, new { @class = "mb-2" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.LoadId" />
                                                    <select name="driverId" class="form-control form-control-sm mb-1" required>
                                                        <option value="">-- Assign Driver --</option>
                                                        @foreach (var driver in availableDrivers)
                                                        {
                                                            <option value="@driver.DriverId">@driver.FullName — @driver.VehicleRegistration</option>
                                                        }
                                                    </select>
                                                    <select name="routeSafety" class="form-control form-control-sm mb-1">
                                                        <option value="Safe">Safe Route</option>
                                                        <option value="Caution">Caution Required</option>
                                                        <option value="High Risk">High Risk</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-success btn-block">Accept & Email</button>
                                                }
                                                using (Html.BeginForm("RejectRequest", "Loads", FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.LoadId" />
                                                    <select name="rejectionReason" class="form-control form-control-sm mb-1" required>
                                                        <option value="">-- Select Reason --</option>
                                                        <option value="Location is too far">Location is too far</option>
                                                        <option value="Route is too dangerous">Route is too dangerous</option>
                                                        <option value="Invalid cargo specifications">Invalid cargo specifications</option>
                                                        <option value="Vehicle capacity exceeded">Vehicle capacity exceeded</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-outline-danger btn-block">Reject</button>
                                                }
                                            }
                                            else if (userRole == "Admin" && item.Status == "Paid / Processing")
                                            {
                                                <a href="@Url.Action("DriverCheckout", "Payment", new { id = item.LoadId })" class="btn btn-sm btn-success">Pay Driver</a>
                                            }
                                            else if (userRole == "Customer" && item.Status == "Delivered")
                                            {
                                                <a href="@Url.Action("Checkout", "Payment", new { id = item.LoadId })" class="btn btn-sm btn-success mb-1">Pay Now</a>
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        onclick="printPODReceipt('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.CargoDescription', 'Vehicle #@item.AssignedVehicleId', '@(item.CollectionPasscode ?? "N/A")')">
                                                    POD Receipt
                                                </button>
                                            }
                                            else if (item.Status == "Delivered")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        onclick="printPODReceipt('@item.TrackingNumber', '@item.PickupLocation', '@item.DropoffLocation', '@item.CargoDescription', 'Vehicle #@item.AssignedVehicleId', '@(item.CollectionPasscode ?? "N/A")')">
                                                    POD Receipt
                                                </button>
                                            }
                                            else if (item.Status == "Completed")
                                            {
                                                <span class="small">Job Fully Completed</span>
                                            }
                                            else
                                            {
                                                <span class="small">No action required</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (userRole == "Admin")
    {
        <div class="card shadow mb-5">
            <div class="card-header py-3">
                <h5 class="mb-0 font-weight-bold">System Audit Trail & History</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Audit ID</th>
                                <th>Load ID</th>
                                <th>Action Performed</th>
                                <th>Shipment Ref</th>
                                <th>Performed By</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!auditLogs.Any())
                            {
                                <tr><td colspan="6" class="text-center py-4">No system audit logs found.</td></tr>
                            }
                            else
                            {
                                foreach (var log in auditLogs)
                                {
                                    <tr>
                                        <td>@log.AuditId</td>
                                        <td>#@log.LoadId</td>
                                        <td>@log.Action</td>
                                        <td>
                                            @(log.Load != null && !string.IsNullOrEmpty(log.Load.TrackingNumber)
                                                ? log.Load.TrackingNumber
                                                : "#" + log.LoadId)
                                        </td>
                                        <td>@log.PerformedBy</td>
                                        <td>@(log.Timestamp.HasValue ? log.Timestamp.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@foreach (var item in loadList)
{
    if (userRole == "Driver" && (item.IsCollected ?? false) && item.Status != "Delivered" && item.Status != "Paid / Processing" && item.Status != "Completed")
    {
        <div class="modal fade" id="deliveryModal@(item.LoadId)" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    @using (Html.BeginForm("MarkDelivered", "Loads", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.LoadId" />
                        <div class="modal-header">
                            <h5 class="modal-title">Confirm Delivery</h5>
                            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                        </div>
                        <div class="modal-body">
                            <input type="text" name="scannedQRCode" class="form-control" placeholder="e.g. @item.TrackingNumber" required />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success btn-sm">Confirm Delivery</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

<div class="modal fade" id="trackingMapModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mapModalTitle">Shipment Tracking</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body p-0">
                <div id="leafletMap" style="height: 420px; width: 100%;"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="podModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div id="printablePOD" class="modal-body p-4 bg-white text-dark">
                <h4>KEYSTONE LOGISTICS</h4>
                <table class="table table-bordered table-sm">
                    <tr><th>Tracking Number</th><td id="podTracking"></td></tr>
                    <tr><th>Pickup Origin</th><td id="podPickup"></td></tr>
                    <tr><th>Dropoff Destination</th><td id="podDropoff"></td></tr>
                    <tr><th>Cargo Description</th><td id="podCargo"></td></tr>
                    <tr><th>Assigned Fleet</th><td id="podVehicle"></td></tr>
                    <tr><th>Verification PIN</th><td id="podPIN"></td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger" onclick="triggerPODPrint()">Print / Save PDF</button>
            </div>
        </div>
    </div>
</div>

<script>
    let map = null;
    let animationInterval = null;
    function lerp(start, end, t) { return start + (end - start) * t; }
    async function geocodeAddress(address) {
        try {
            const query = address.toLowerCase().includes('south africa') ? address : address + ', South Africa';
            const response = await fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(query));
            const data = await response.json();
            if (data && data.length > 0) return [parseFloat(data[0].lat), parseFloat(data[0].lon)];
        } catch (err) { }
        return null;
    }
    function openMapModal(trackingNum, pickup, dropoff, status) {
        $('#mapModalTitle').text('Shipment Tracking (' + trackingNum + ')');
        $('#trackingMapModal').modal('show');
        if (animationInterval) clearInterval(animationInterval);
        $('#trackingMapModal').off('shown.bs.modal').on('shown.bs.modal', async function () {
            if (map !== null) map.remove();
            map = L.map('leafletMap').setView([-29.8587, 31.0218], 9);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap' }).addTo(map);
            let pickupCoords = await geocodeAddress(pickup) || [-29.8732, 31.0253];
            let dropoffCoords = await geocodeAddress(dropoff) || [-29.6006, 30.3794];
            L.marker(pickupCoords).addTo(map).bindPopup('Pickup: ' + pickup);
            L.marker(dropoffCoords).addTo(map).bindPopup('Destination: ' + dropoff);
            let vehicleMarker = L.marker(pickupCoords).addTo(map);
            const routeLine = L.polyline([pickupCoords, dropoffCoords], { color: '#2F6F5E', weight: 4 }).addTo(map);
            map.fitBounds(routeLine.getBounds(), { padding: [50, 50] });
            map.invalidateSize();
            if (status === 'En Route') {
                let t = 0, step = 0.0004;
                animationInterval = setInterval(() => {
                    t += step;
                    if (t > 1 || t < 0) step = -step;
                    vehicleMarker.setLatLng([lerp(pickupCoords[0], dropoffCoords[0], t), lerp(pickupCoords[1], dropoffCoords[1], t)]);
                }, 50);
            }
        });
    }
    function filterTable() {
        var input = document.getElementById('loadSearchInput');
        if (!input) return;
        let filter = input.value.toLowerCase();
        let table = document.getElementById('loadsTable');
        if (!table) return;
        let trs = table.getElementsByTagName('tr');
        for (let i = 1; i < trs.length; i++) {
            trs[i].style.display = (trs[i].textContent || trs[i].innerText).toLowerCase().indexOf(filter) > -1 ? '' : 'none';
        }
    }
    function printPODReceipt(tracking, pickup, dropoff, cargo, vehicle, pin) {
        document.getElementById('podTracking').innerText = tracking;
        document.getElementById('podPickup').innerText = pickup;
        document.getElementById('podDropoff').innerText = dropoff;
        document.getElementById('podCargo').innerText = cargo;
        document.getElementById('podVehicle').innerText = vehicle;
        document.getElementById('podPIN').innerText = pin;
        $('#podModal').modal('show');
    }
    function triggerPODPrint() {
        let printContents = document.getElementById('printablePOD').innerHTML;
        let originalContents = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = originalContents;
        location.reload();
    }
</script>