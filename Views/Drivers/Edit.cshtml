@model KeystoneLogistics.Models.Driver

@{
    ViewBag.Title = "Edit Driver";
}

<style>
    .glass-card-dark {
        background: rgba(255, 255, 255, 0.03) !important;
        backdrop-filter: blur(16px) saturate(180%);
        -webkit-backdrop-filter: blur(16px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 14px !important;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
        color: #f8fafc;
    }

    .form-control-dark {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        color: #fff !important;
        border-radius: 8px !important;
    }

        .form-control-dark:focus {
            background: rgba(255, 255, 255, 0.08) !important;
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 0.2rem rgba(56, 189, 248, 0.25) !important;
            color: #fff !important;
        }

        .form-control-dark option {
            background-color: #1e293b;
            color: #fff;
        }
</style>

<div class="container py-4" style="min-height: 80vh;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold text-white mb-1">
                <i class="fa-solid fa-pen-to-square mr-2 text-info"></i>Edit Driver
            </h2>
            <p class="text-muted mb-0" style="color: #94a3b8 !important;">Update driver details and status</p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-light font-weight-bold" style="border-radius: 8px;">
            <i class="fa-solid fa-arrow-left mr-1"></i> Back to List
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="glass-card-dark p-4 p-md-5">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.DriverId)

                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                    <div class="form-group mb-3">
                        @Html.LabelFor(model => model.FullName, "Full Name", htmlAttributes: new { @class = "text-uppercase small font-weight-bold text-muted mb-1" })
                        @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @class = "form-control form-control-dark py-2" } })
                        @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger small mt-1" })
                    </div>

                    <div class="form-group mb-3">
                        @Html.LabelFor(model => model.Phone, "Phone Number", htmlAttributes: new { @class = "text-uppercase small font-weight-bold text-muted mb-1" })
                        @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control form-control-dark py-2" } })
                        @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger small mt-1" })
                    </div>

                    <div class="form-group mb-3">
                        @Html.LabelFor(model => model.VehicleRegistration, "Vehicle Registration", htmlAttributes: new { @class = "text-uppercase small font-weight-bold text-muted mb-1" })
                        @Html.EditorFor(model => model.VehicleRegistration, new { htmlAttributes = new { @class = "form-control form-control-dark py-2" } })
                        @Html.ValidationMessageFor(model => model.VehicleRegistration, "", new { @class = "text-danger small mt-1" })
                    </div>

                    <div class="form-group mb-4">
                        @Html.LabelFor(model => model.IsAvailable, "Availability Status", htmlAttributes: new { @class = "text-uppercase small font-weight-bold text-muted mb-1" })
                        @Html.DropDownListFor(model => model.IsAvailable, new SelectList(new[]
                        {
                            new { Text = "Available", Value = "True" },
                            new { Text = "Unavailable / On Load", Value = "False" }
                        }, "Value", "Text"), new { @class = "form-control form-control-dark py-2" })
                        @Html.ValidationMessageFor(model => model.IsAvailable, "", new { @class = "text-danger small mt-1" })
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4" style="border-radius: 8px;">Cancel</a>
                        <button type="submit" class="btn btn-info font-weight-bold px-4 text-white shadow-sm" style="border-radius: 8px;">
                            <i class="fa-solid fa-floppy-disk mr-1"></i> Save Changes
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}