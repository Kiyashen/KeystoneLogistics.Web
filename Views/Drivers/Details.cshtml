@model KeystoneLogistics.Models.Driver

@{
    ViewBag.Title = "Driver Details";
}

<style>
    .glass-card-dark {
        background: rgba(255, 255, 255, 0.03) !important;
        backdrop-filter: blur(16px) saturate(180%);
        -webkit-backdrop-filter: blur(16px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 14px !important;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
        color: #f8fafc;
    }
</style>

<div class="container py-4" style="min-height: 80vh;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold text-white mb-1">
                <i class="fa-solid fa-user-shield mr-2 text-info"></i>Driver Profile
            </h2>
            <p class="text-muted mb-0" style="color: #94a3b8 !important;">Detailed view for driver record</p>
        </div>
        <div>
            <a href="@Url.Action("Edit", new { id = Model.DriverId })" class="btn btn-info font-weight-bold mr-2 text-white" style="border-radius: 8px;">
                <i class="fa-solid fa-pen mr-1"></i> Edit
            </a>
            <a href="@Url.Action("Index")" class="btn btn-outline-light font-weight-bold" style="border-radius: 8px;">
                <i class="fa-solid fa-arrow-left mr-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="glass-card-dark p-4 p-md-5">
                <div class="d-flex align-items-center mb-4 pb-3 border-bottom" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mr-3" style="width: 60px; height: 60px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; font-size: 24px;">
                        <i class="fa-solid fa-id-badge"></i>
                    </div>
                    <div>
                        <span class="text-uppercase small font-weight-bold text-info" style="letter-spacing: 1px;">Driver Name</span>
                        <h3 class="font-weight-bold text-white mb-0">@Model.FullName</h3>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="text-uppercase font-weight-bold small text-muted" style="letter-spacing: 0.5px;">Phone Number</label>
                        <div class="text-white font-weight-bold p-2 rounded" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                            @Model.Phone
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-uppercase font-weight-bold small text-muted" style="letter-spacing: 0.5px;">Vehicle Registration</label>
                        <div class="text-info font-weight-bold p-2 rounded" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                            @Model.VehicleRegistration
                        </div>
                    </div>

                    <div class="col-12 mb-3">
                        <label class="text-uppercase font-weight-bold small text-muted" style="letter-spacing: 0.5px;">Availability Status</label>
                        <div class="text-white font-weight-bold p-2 rounded" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                            @if (Model.IsAvailable == true)
                            {
                                <span class="badge badge-success px-3 py-2" style="font-size: 13px;">Available</span>
                            }
                            else
                            {
                                <span class="badge badge-warning px-3 py-2" style="font-size: 13px;">Unavailable / On Load</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>