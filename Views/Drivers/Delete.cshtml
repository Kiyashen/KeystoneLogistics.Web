@model KeystoneLogistics.Models.Driver

@{
    ViewBag.Title = "Delete Driver";
}

<style>
    .glass-card-dark {
        background: rgba(255, 255, 255, 0.03) !important;
        backdrop-filter: blur(16px) saturate(180%);
        -webkit-backdrop-filter: blur(16px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 14px !important;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
        color: #f8fafc;
    }
</style>

<div class="container py-4" style="min-height: 80vh;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold text-white mb-1">
                <i class="fa-solid fa-triangle-exclamation mr-2 text-danger"></i>Delete Driver
            </h2>
            <p class="text-muted mb-0" style="color: #94a3b8 !important;">Are you sure you want to permanently delete this driver?</p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-light font-weight-bold" style="border-radius: 8px;">
            <i class="fa-solid fa-arrow-left mr-1"></i> Back to List
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="glass-card-dark p-4 p-md-5">

                <div class="alert mb-4 border-0 shadow-sm" role="alert" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border-left: 4px solid #ef4444 !important;">
                    <i class="fa-solid fa-circle-exclamation mr-2"></i> <strong>Warning:</strong> This action cannot be undone. All associated data and assignments for this driver will be removed.
                </div>

                <div class="mb-4 pb-3 border-bottom" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                    <span class="text-uppercase small font-weight-bold text-danger" style="letter-spacing: 1px;">Target Driver</span>
                    <h3 class="font-weight-bold text-white mt-1">@Model.FullName</h3>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="text-uppercase font-weight-bold small text-muted" style="letter-spacing: 0.5px;">Phone Number</label>
                        <div class="text-white font-weight-bold p-2 rounded" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                            @Model.Phone
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-uppercase font-weight-bold small text-muted" style="letter-spacing: 0.5px;">Vehicle Registration</label>
                        <div class="text-info font-weight-bold p-2 rounded" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                            @Model.VehicleRegistration
                        </div>
                    </div>

                    <div class="col-12 mb-4">
                        <label class="text-uppercase font-weight-bold small text-muted" style="letter-spacing: 0.5px;">Availability Status</label>
                        <div class="text-white font-weight-bold p-2 rounded" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
                            @if (Model.IsAvailable == true)
                            {
                                <span class="badge badge-success px-3 py-2" style="font-size: 13px;">Available</span>
                            }
                            else
                            {
                                <span class="badge badge-warning px-3 py-2" style="font-size: 13px;">Unavailable / On Load</span>
                            }
                        </div>
                    </div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4" style="border-radius: 8px;">Cancel</a>
                        <button type="submit" class="btn font-weight-bold px-4 text-white shadow-sm" style="border-radius: 8px; background-color: #dc2626; border: none;">
                            <i class="fa-solid fa-trash mr-1"></i> Yes, Delete Driver
                        </button>
                    </div>
                }

            </div>
        </div>
    </div>
</div>