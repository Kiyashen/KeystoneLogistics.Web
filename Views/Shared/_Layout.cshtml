@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string userRole = Session["UserRole"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Keystone Logistics</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #F4EFE6;
            --bg-soft: #EBE3D4;
            --text-main: #3A3226;
            --text-muted: #6B6358;
            --glass-card: #FFFCF7;
            --glass-border: rgba(122, 110, 92, 0.18);
            --navbar-bg: rgba(255, 252, 247, 0.95);
            --footer-bg: #3A3226;
            --footer-text: #EBE3D4;
            --table-th-bg: #EBE3D4;
            --table-th-color: #3A3226;
            --table-td-color: #3A3226;
            --table-hover-bg: rgba(122, 110, 92, 0.08);
            --card-shadow: 0 10px 30px rgba(58, 50, 38, 0.08);
            --accent: #2F6F5E;
            --accent-soft: rgba(47, 111, 94, 0.12);
            --accent-border: rgba(47, 111, 94, 0.35);
            --warning: #C47B2D;
            --danger: #B5483A;
            --info: #3A7CA5;
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            background-color: var(--bg-main);
            color: var(--text-main);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        body, h1, h2, h3, h4, h5, h6,
        .h1, .h2, .h3, .h4, .h5, .h6,
        p, span, a, li, label, .form-label, .col-form-label {
            color: var(--text-main);
        }

        .text-muted {
            color: var(--text-muted) !important;
        }

        .text-white, .text-light {
            color: var(--text-main) !important;
        }

        .main-wrapper {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: var(--bg-main);
        }

        .content-body {
            flex: 1 0 auto;
            padding-top: 40px;
            padding-bottom: 60px;
        }

            .content-body h3,
            .content-body h4,
            .content-body h5,
            .content-body label,
            .content-body .small,
            .content-body p {
                color: #1F1A14 !important;
            }

        .form-control,
        input,
        select,
        textarea {
            background-color: #FFFFFF !important;
            color: #1F1A14 !important;
            -webkit-text-fill-color: #1F1A14 !important;
            border: 1px solid var(--glass-border) !important;
            border-radius: 10px;
            padding: 12px 16px;
            font-weight: 500;
            height: auto;
        }

            .form-control:focus,
            input:focus,
            select:focus,
            textarea:focus {
                border-color: var(--accent) !important;
                box-shadow: 0 0 0 3px var(--accent-soft);
            }

            .form-control::placeholder {
                color: var(--text-muted);
                opacity: 0.85;
            }

        .navbar-glass {
            background: var(--navbar-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--glass-border);
            padding: 14px 28px;
        }

            .navbar-glass .navbar-brand {
                color: var(--text-main) !important;
                font-weight: 700;
                font-size: 1.15rem;
                letter-spacing: 0.5px;
            }

            .navbar-glass .nav-link {
                color: var(--text-main) !important;
                font-weight: 500;
                font-size: 0.9rem;
                padding: 8px 16px !important;
                border-radius: 8px;
                opacity: 0.8;
                transition: all 0.2s ease;
            }

                .navbar-glass .nav-link:hover,
                .navbar-glass .nav-item.active .nav-link {
                    opacity: 1;
                    background: var(--accent-soft);
                    color: var(--accent) !important;
                }

        .data-card, .card,
        .shadow, .shadow-sm, .shadow-lg {
            background: var(--glass-card) !important;
            border: 1px solid var(--glass-border) !important;
            border-radius: 16px;
            box-shadow: var(--card-shadow);
            color: #1F1A14 !important;
        }

        .table {
            color: var(--text-main) !important;
            margin-bottom: 0;
            background-color: transparent !important;
        }

            .table thead,
            .table thead tr,
            .table thead th,
            .table .thead-light th,
            .thead-light th {
                background-color: var(--table-th-bg) !important;
                color: var(--table-th-color) !important;
                font-weight: 700 !important;
                font-size: 0.8rem !important;
                text-transform: uppercase;
                letter-spacing: 0.8px;
                border-bottom: 2px solid var(--glass-border) !important;
                border-top: none !important;
                padding: 16px !important;
            }

            .table td {
                color: var(--table-td-color) !important;
                border-top: 1px solid var(--glass-border) !important;
                vertical-align: middle;
                padding: 16px;
                font-weight: 500;
            }

                .table td span:not(.badge), .table td code {
                    color: var(--text-main) !important;
                    background: transparent !important;
                }

        .table-hover tbody tr:hover {
            background-color: var(--table-hover-bg) !important;
        }

        .badge-warning {
            background-color: var(--warning) !important;
            color: #fff !important;
        }

        .badge-danger {
            background-color: var(--danger) !important;
            color: #fff !important;
        }

        .badge-success {
            background-color: var(--accent) !important;
            color: #fff !important;
        }

        .badge-info {
            background-color: var(--info) !important;
            color: #fff !important;
        }

        .badge-primary {
            background-color: var(--accent) !important;
            color: #fff !important;
        }

        .badge-secondary {
            background-color: #9A8E7C !important;
            color: #fff !important;
        }

        .badge-dark {
            background-color: var(--text-main) !important;
            color: #fff !important;
        }

        .btn-success {
            background-color: var(--accent) !important;
            border-color: var(--accent) !important;
        }

            .btn-success:hover {
                background-color: #255a4b !important;
                border-color: #255a4b !important;
            }

        .btn-outline-success {
            color: var(--accent) !important;
            border-color: var(--accent) !important;
        }

            .btn-outline-success:hover {
                background-color: var(--accent) !important;
                color: #fff !important;
            }

        .btn-outline-info {
            color: var(--info) !important;
            border-color: var(--info) !important;
        }

            .btn-outline-info:hover {
                background-color: var(--info) !important;
                color: #fff !important;
            }

        .btn-outline-light {
            color: var(--text-main) !important;
            border-color: var(--glass-border) !important;
        }

            .btn-outline-light:hover {
                background-color: var(--bg-soft) !important;
                color: var(--text-main) !important;
            }

        .btn-outline-danger {
            color: var(--danger) !important;
            border-color: var(--danger) !important;
        }

            .btn-outline-danger:hover {
                background-color: var(--danger) !important;
                color: #fff !important;
            }

        .btn-outline-secondary {
            color: var(--text-muted) !important;
            border-color: var(--glass-border) !important;
        }

            .btn-outline-secondary:hover {
                background-color: var(--bg-soft) !important;
                color: var(--text-main) !important;
            }

        .btn-primary {
            background-color: var(--accent) !important;
            border-color: var(--accent) !important;
        }

            .btn-primary:hover {
                background-color: #255a4b !important;
                border-color: #255a4b !important;
            }

        .btn-info {
            background-color: var(--info) !important;
            border-color: var(--info) !important;
        }

        .btn-warning {
            background-color: var(--warning) !important;
            border-color: var(--warning) !important;
            color: #fff !important;
        }

        .text-info, .text-success, i.text-info, i.text-success {
            color: var(--accent) !important;
        }

        .text-warning {
            color: var(--warning) !important;
        }

        .text-danger {
            color: var(--danger) !important;
        }

        .alert-success {
            background-color: var(--accent-soft) !important;
            border-color: var(--accent-border) !important;
            color: var(--accent) !important;
        }

        .alert-danger {
            background-color: rgba(181, 72, 58, 0.1) !important;
            border-color: rgba(181, 72, 58, 0.3) !important;
            color: var(--danger) !important;
        }

        .footer-glass {
            background: var(--footer-bg);
            color: var(--footer-text);
            padding: 40px 0 20px 0;
            font-size: 0.875rem;
            margin-top: auto;
        }

            .footer-glass h6 {
                color: var(--footer-text);
                font-weight: 700;
                margin-bottom: 16px;
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 1px;
            }

            .footer-glass p,
            .footer-glass span,
            .footer-glass li,
            .footer-glass a {
                color: var(--footer-text) !important;
            }

            .footer-glass ul {
                list-style: none;
                padding-left: 0;
                margin-bottom: 0;
            }

                .footer-glass ul li {
                    margin-bottom: 10px;
                }

                    .footer-glass ul li a {
                        text-decoration: none;
                        opacity: 0.8;
                    }

                        .footer-glass ul li a:hover {
                            opacity: 1;
                        }

        .btn-glass-primary {
            background: var(--accent-soft);
            border: 1px solid var(--accent-border);
            color: var(--accent) !important;
            font-weight: 600;
            border-radius: 8px;
            padding: 8px 20px;
            transition: all 0.2s ease;
        }

            .btn-glass-primary:hover {
                background: var(--accent);
                border-color: var(--accent);
                color: #fff !important;
            }

        .input-group-text {
            background-color: var(--bg-soft) !important;
            color: var(--text-main) !important;
            border-color: var(--glass-border) !important;
        }

        code {
            color: var(--accent) !important;
            background: var(--accent-soft) !important;
        }

        .bg-dark,
        .navbar-dark,
        .table-dark,
        .card.bg-dark,
        .modal-content.bg-dark,
        .jumbotron.bg-dark,
        .card.bg-secondary,
        .bg-secondary {
            background-color: #FFFCF7 !important;
            color: #1F1A14 !important;
        }

            .table-dark td,
            .table-dark th,
            .table-dark thead th {
                background-color: transparent !important;
                color: #3A3226 !important;
                border-color: rgba(122, 110, 92, 0.18) !important;
            }

        .lead, .page-subtitle, .small, small {
            color: #5C5348 !important;
        }

        .bg-dark .text-white,
        .bg-dark .text-light,
        .bg-dark h1, .bg-dark h2, .bg-dark h3, .bg-dark h4, .bg-dark h5 {
            color: #1F1A14 !important;
        }
    </style>
</head>
<body>
    <div class="main-wrapper">
        <nav class="navbar navbar-expand-lg navbar-glass sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
                    <i class="fa-solid fa-truck-fast mr-2" style="color: var(--accent);"></i> KEYSTONE LOGISTICS
                </a>
                <button class="navbar-toggler border-0" type="button" data-toggle="collapse" data-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    @if (Session["Username"] != null)
                    {
                        <ul class="navbar-nav mr-auto ml-lg-4">
                            <li class="nav-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                                <a class="nav-link" href="@Url.Action("Index", "Home")">Home</a>
                            </li>
                            <li class="nav-item @(currentController == "Home" && currentAction == "About" ? "active" : "")">
                                <a class="nav-link" href="@Url.Action("About", "Home")">About Us</a>
                            </li>
                            <li class="nav-item @(currentController == "Loads" && currentAction == "Index" ? "active" : "")">
                                <a class="nav-link" href="@Url.Action("Index", "Loads")">Freight Loads</a>
                            </li>
                            @if (userRole == "Admin")
                            {
                                <li class="nav-item @(currentController == "Customers" ? "active" : "")">
                                    <a class="nav-link" href="@Url.Action("Index", "Customers")">Customers</a>
                                </li>
                                <li class="nav-item @(currentController == "Drivers" ? "active" : "")">
                                    <a class="nav-link" href="@Url.Action("Index", "Drivers")">Drivers</a>
                                </li>
                            }
                            <li class="nav-item @(currentController == "Home" && currentAction == "Contact" ? "active" : "")">
                                <a class="nav-link" href="@Url.Action("Contact", "Home")">Contact</a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <div class="mr-auto"></div>
                    }
                    <ul class="navbar-nav ml-auto align-items-center">
                        @if (Session["Username"] != null)
                        {
                            <li class="nav-item mr-3">
                                <span class="small d-flex align-items-center">
                                    <i class="fa-regular fa-circle-user mr-1 font-weight-bold" style="color: var(--accent);"></i>
                                    <strong class="mr-1">@Session["Username"]</strong>
                                    <span class="badge px-2 py-1" style="background: var(--accent-soft); color: var(--accent);">@Session["UserRole"]</span>
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm rounded-pill px-3" href="@Url.Action("Logout", "Account")">
                                    Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-glass-primary btn-sm" href="@Url.Action("Login", "Account")">
                                    <i class="fa-solid fa-arrow-right-to-bracket mr-1"></i> Sign In
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
        <div class="content-body">
            @RenderBody()
        </div>
        @if (Session["Username"] != null)
        {
            <footer class="footer-glass">
                <div class="container">
                    <div class="row">
                        <div class="col-md-4 mb-4">
                            <h6>Keystone Logistics</h6>
                            <p class="small mb-2">Streamlined logistics and freight management solutions across KZN corridors.</p>
                            <p class="small mb-0"><i class="fa-solid fa-location-dot mr-1"></i> Durban, South Africa</p>
                        </div>
                        <div class="col-md-4 mb-4">
                            <h6>Quick Links</h6>
                            <ul>
                                <li><a href="@Url.Action("About", "Home")">About Company</a></li>
                                <li><a href="@Url.Action("Index", "Loads")">Loads Overview</a></li>
                                <li><a href="@Url.Action("Contact", "Home")">Support Portal</a></li>
                            </ul>
                        </div>
                        <div class="col-md-4 mb-4">
                            <h6>Dispatch Support</h6>
                            <p class="small mb-2">Need immediate operational assistance?</p>
                            <a href="https://wa.me/27311234567" target="_blank" class="btn btn-sm border-0 shadow-sm" style="background: rgba(47, 111, 94, 0.25); font-weight: 600; color: #EBE3D4 !important;">
                                <i class="fa-brands fa-whatsapp mr-1"></i> WhatsApp Support
                            </a>
                        </div>
                    </div>
                    <div class="text-center pt-3 mt-3 border-top" style="border-color: rgba(235, 227, 212, 0.2) !important;">
                        <span class="small">&copy; @DateTime.Now.Year Keystone Logistics. All rights reserved.</span>
                    </div>
                </div>
            </footer>
        }
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>