@model IEnumerable<KeystoneLogistics.Models.AuditLog>

@{
    ViewBag.Title = "System Audit Logs";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>System Audit Trail & History</h2>
        <span class="text-muted">Tracking system activities and load changes</span>
    </div>
    <hr />

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Audit ID</th>
                <th>Load ID</th>
                <th>Action Performed</th>
                <th>Performed By</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.AuditId</td>
                    <td><span class="badge bg-secondary">#@item.LoadId</span></td>
                    <td><strong>@item.Action</strong></td>
                    <td>@item.PerformedBy</td>
                    <td>@item.Timestamp</td>
                </tr>
            }
        </tbody>
    </table>
</div>