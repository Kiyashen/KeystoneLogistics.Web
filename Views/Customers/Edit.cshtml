@model IEnumerable<KeystoneLogistics.Models.Customer>

@{
    ViewBag.Title = "Registered Customers";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold mb-1">Registered Customers</h2>
            <p class="text-muted mb-0">Manage customer profiles and contact details</p>
        </div>
        <a href="@Url.Action("Create")" class="btn btn-primary font-weight-bold px-4 py-2" style="border-radius: 8px;">
            + Add New Customer
        </a>
    </div>

    <div class="executive-card">
        <div class="table-responsive">
            <table class="executive-table">
                <thead>
                    <tr>
                        <th>Company Name</th>
                        <th>Contact Person</th>
                        <th>Email Address</th>
                        <th>Phone Number</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.CompanyName</strong></td>
                                <td>@item.ContactPerson</td>
                                <td><a href="mailto:@item.Email" class="text-primary font-weight-bold">@item.Email</a></td>
                                <td>@item.Phone</td>
                                <td class="text-right">
                                    <a href="@Url.Action("Edit", new { id = item.CustomerId })" class="btn-action-edit mr-1">Edit</a>
                                    <a href="@Url.Action("Details", new { id = item.CustomerId })" class="btn-action-details mr-1">Details</a>
                                    <a href="@Url.Action("Delete", new { id = item.CustomerId })" class="btn btn-sm btn-outline-danger font-weight-bold" style="border-radius: 6px;">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No customer records found. Click "+ Add New Customer" to create one.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>