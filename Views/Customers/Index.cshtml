@model IEnumerable<KeystoneLogistics.Models.Customer>

@{
    ViewBag.Title = "Registered Customers";
}

<div class="container py-4">

    <!-- Page Header & Action Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 font-weight-bold"><i class="fa-solid fa-users text-info mr-2"></i>Registered Customers</h2>
            <p class="text-muted mb-0">Manage customer accounts and contact details</p>
        </div>
        <a href="@Url.Action("Create")" class="btn btn-primary font-weight-bold shadow-sm" style="border-radius: 10px; padding: 10px 20px;">
            <i class="fa-solid fa-plus mr-2"></i> Add New Customer
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border-left: 4px solid #10b981 !important;">
            <i class="fa-solid fa-circle-check mr-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Customers Table Card -->
    <div class="card data-card shadow-lg border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Company Name</th>
                            <th>Contact Person</th>
                            <th>Phone Number</th>
                            <th>Email</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="font-weight-bold">@item.CompanyName</td>
                                    <td>@item.ContactPerson</td>
                                    <td>
                                        <a href="tel:@item.Phone" class="text-decoration-none" style="color: inherit;">@item.Phone</a>
                                    </td>
                                    <td>
                                        <a href="mailto:@item.Email" class="text-info text-decoration-none">@item.Email</a>
                                    </td>
                                    <td class="text-right">
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Edit", new { id = item.CustomerId })" class="btn btn-sm btn-outline-secondary mr-1 rounded" title="Edit">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <a href="@Url.Action("Details", new { id = item.CustomerId })" class="btn btn-sm btn-outline-info mr-1 rounded" title="Details">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Delete", new { id = item.CustomerId })" class="btn btn-sm btn-outline-danger rounded" title="Delete">
                                                <i class="fa-solid fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-users-slash fa-2x mb-2 d-block text-secondary"></i>
                                    No customer records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>