@model IEnumerable<KeystoneLogistics.Models.Customer>

@{
    ViewBag.Title = "Registered Customers";
}

<div class="container py-5" style="position: relative; z-index: 10; min-height: 80vh; background: radial-gradient(circle at 50% 45%, #1e293b 0%, #0f172a 60%, #0b1120 100%);">
    
    <!-- Page Header & Action Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="font-weight-bold text-white mb-1"><i class="fa-solid fa-users text-info mr-2"></i>Registered Customers</h1>
            <p class="text-muted small mb-0">Manage customer accounts and contact details</p>
        </div>
        <a href="@Url.Action("Create")" class="btn btn-info font-weight-bold px-3 py-2 text-dark shadow-sm" style="border-radius: 8px; background-color: #38bdf8; border-color: #38bdf8;">
            <i class="fa-solid fa-plus mr-1"></i> Add New Customer
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border-left: 4px solid #10b981 !important;">
            <i class="fa-solid fa-circle-check mr-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="close text-white" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Customers Table Glass Card -->
    <div class="card shadow-lg border-0" style="background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.12) !important; border-radius: 20px; color: #ffffff;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" style="color: #f8fafc;">
                    <thead>
                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                            <th class="py-3 px-4 text-uppercase font-weight-bold small text-muted" style="letter-spacing: 0.5px;">Company Name</th>
                            <th class="py-3 px-4 text-uppercase font-weight-bold small text-muted" style="letter-spacing: 0.5px;">Contact Person</th>
                            <th class="py-3 px-4 text-uppercase font-weight-bold small text-muted" style="letter-spacing: 0.5px;">Phone Number</th>
                            <th class="py-3 px-4 text-uppercase font-weight-bold small text-muted" style="letter-spacing: 0.5px;">Email</th>
                            <th class="py-3 px-4 text-uppercase font-weight-bold small text-muted text-right" style="letter-spacing: 0.5px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05); transition: background 0.2s ease;">
                                    <td class="py-3 px-4 font-weight-bold text-white align-middle">@item.CompanyName</td>
                                    <td class="py-3 px-4 text-muted align-middle">@item.ContactPerson</td>
                                    <td class="py-3 px-4 text-muted align-middle">
                                        <a href="tel:@item.Phone" class="text-muted text-decoration-none hover-info">@item.Phone</a>
                                    </td>
                                    <td class="py-3 px-4 text-muted align-middle">
                                        <a href="mailto:@item.Email" class="text-info text-decoration-none">@item.Email</a>
                                    </td>
                                    <td class="py-3 px-4 text-right align-middle">
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Edit", new { id = item.CustomerId })" class="btn btn-sm btn-outline-secondary mr-1 rounded" title="Edit" style="border-color: rgba(255, 255, 255, 0.2); color: #cbd5e1;">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <a href="@Url.Action("Details", new { id = item.CustomerId })" class="btn btn-sm btn-outline-info mr-1 rounded" title="Details" style="border-color: rgba(56, 189, 248, 0.3); color: #38bdf8;">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Delete", new { id = item.CustomerId })" class="btn btn-sm btn-outline-danger rounded" title="Delete" style="border-color: rgba(239, 68, 68, 0.3); color: #f87171;">
                                                <i class="fa-solid fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-users-slash fa-2x mb-2 d-block text-secondary"></i>
                                    No customer records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(30, 41, 59, 0.4) !important;
    }
    .hover-info:hover {
        color: #38bdf8 !important;
    }
</style>