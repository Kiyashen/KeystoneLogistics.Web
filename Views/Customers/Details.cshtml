@model KeystoneLogistics.Models.Customer
@{
    ViewBag.Title = "Customer Details";
}

<div class="container py-5">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 mb-2">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Customers")" class="text-decoration-none" style="color: #2F6F5E;">Customers</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
            <h1 class="font-weight-bold mb-1">
                <i class="fa-solid fa-address-card mr-2" style="color: #2F6F5E;"></i>Customer Details
            </h1>
            <p class="small mb-0" style="color: #6B6358;">Comprehensive profile and contact information for @Model.CompanyName</p>
        </div>
        <div class="col-auto">
            <a href="@Url.Action("Index", "Customers")" class="btn btn-outline-secondary btn-sm font-weight-bold px-3">
                <i class="fa-solid fa-arrow-left mr-2"></i>Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                        <div class="rounded-circle d-flex align-items-center justify-content-center mr-3"
                             style="width: 60px; height: 60px; background: rgba(47, 111, 94, 0.12); color: #2F6F5E; font-size: 24px; flex-shrink: 0;">
                            <i class="fa-solid fa-building"></i>
                        </div>
                        <div>
                            <span class="badge text-uppercase mb-1"
                                  style="font-size: 10px; letter-spacing: 1.5px; color: #2F6F5E; background: rgba(47, 111, 94, 0.12); padding: 4px 10px; border-radius: 6px;">
                                Registered Account
                            </span>
                            <h3 class="font-weight-bold mb-0">@Model.CompanyName</h3>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <div class="p-3 rounded" style="background: #EBE3D4;">
                                <div class="text-uppercase font-weight-bold small mb-1" style="letter-spacing: 0.5px; color: #6B6358;">
                                    <i class="fa-solid fa-user mr-1" style="color: #2F6F5E;"></i>
                                    @Html.DisplayNameFor(model => model.ContactPerson)
                                </div>
                                <div class="font-weight-bold" style="font-size: 16px;">
                                    @Model.ContactPerson
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="p-3 rounded" style="background: #EBE3D4;">
                                <div class="text-uppercase font-weight-bold small mb-1" style="letter-spacing: 0.5px; color: #6B6358;">
                                    <i class="fa-solid fa-phone mr-1" style="color: #2F6F5E;"></i>
                                    @Html.DisplayNameFor(model => model.Phone)
                                </div>
                                <div class="font-weight-bold" style="font-size: 16px;">
                                    <a href="tel:@Model.Phone" class="text-decoration-none" style="color: #3A3226;">@Model.Phone</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 mb-4">
                            <div class="p-3 rounded" style="background: #EBE3D4;">
                                <div class="text-uppercase font-weight-bold small mb-1" style="letter-spacing: 0.5px; color: #6B6358;">
                                    <i class="fa-solid fa-envelope mr-1" style="color: #2F6F5E;"></i>
                                    @Html.DisplayNameFor(model => model.Email)
                                </div>
                                <div class="font-weight-bold" style="font-size: 16px;">
                                    <a href="mailto:@Model.Email" class="text-decoration-none" style="color: #2F6F5E;">@Model.Email</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a href="@Url.Action("Index", "Customers")" class="btn btn-outline-secondary btn-sm px-4">
                            <i class="fa-solid fa-arrow-left mr-2"></i>Back to List
                        </a>
                        <a href="@Url.Action("Edit", "Customers", new { id = Model.CustomerId })" class="btn btn-success btn-sm px-4 font-weight-bold">
                            <i class="fa-solid fa-pen-to-square mr-2"></i>Edit Customer
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>