@{
    ViewBag.Title = "Sign In";
}

<style>
    .glass-modal-card {
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .glass-input {
        background: rgba(255, 255, 255, 0.04) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #ffffff !important;
        border-radius: 10px !important;
        padding: 12px 16px;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

        .glass-input:focus {
            background: rgba(255, 255, 255, 0.08) !important;
            border-color: rgba(56, 189, 248, 0.5) !important;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15) !important;
        }

        .glass-input::placeholder {
            color: #64748b;
        }

    .glass-btn {
        background: rgba(255, 255, 255, 0.9);
        color: #0f172a;
        font-weight: 600;
        border-radius: 10px;
        padding: 12px;
        border: none;
        transition: all 0.2s ease;
    }

        .glass-btn:hover {
            background: #ffffff;
            box-shadow: 0 4px 15px rgba(255, 255, 255, 0.2);
            color: #0f172a;
        }

    .demo-pill {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        padding: 10px;
        transition: border 0.2s ease;
    }

        .demo-pill:hover {
            border-color: rgba(255, 255, 255, 0.2);
        }
</style>

<div class="row justify-content-center align-items-center my-4" style="min-height: 68vh;">
    <div class="col-md-6 col-lg-4">

        <!-- Glassmorphism Pop-up Card -->
        <div class="glass-modal-card p-4 p-md-5">

            <!-- Header -->
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center p-3 mb-3 rounded-circle" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);">
                    <i class="fa-solid fa-lock text-info fa-lg"></i>
                </div>
                <h4 class="font-weight-bold text-white mb-1">Welcome Back</h4>
                <p class="text-muted small mb-0">Sign in to your account</p>
            </div>

            <!-- Error Banner -->
            @if (ViewBag.Error != null || ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger border-0 small text-center py-2 mb-4" style="background: rgba(239, 68, 68, 0.15); color: #fca5a5; border-radius: 8px;">
                    <i class="fa-solid fa-circle-exclamation mr-1"></i> @(ViewBag.Error ?? ViewBag.ErrorMessage)
                </div>
            }

            <!-- Success Banner (For Temporary Password / Inbox Simulation) -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 small text-center py-2 mb-4" style="background: rgba(34, 197, 94, 0.15); color: #86efac; border-radius: 8px;">
                    <i class="fa-solid fa-circle-check mr-1"></i> @TempData["SuccessMessage"]
                </div>
            }

            <!-- Form -->
            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group mb-3">
                    <label class="small text-muted font-weight-medium mb-1">Username</label>
                    <input type="text" name="username" class="form-control glass-input" placeholder="Enter username" required autofocus />
                </div>

                <div class="form-group mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="small text-muted font-weight-medium mb-0">Password</label>
                        @Html.ActionLink("Forgot Password?", "ForgotPassword", "Account", null, new { @class = "small text-info text-decoration-none" })
                    </div>
                    <input type="password" name="password" class="form-control glass-input" placeholder="Enter password" required />
                </div>

                <button type="submit" class="btn btn-block glass-btn font-weight-bold mb-3">
                    Sign In
                </button>
            }

            <!-- Minimal Demo Credentials Helper -->
            <div class="mt-4 pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.08) !important;">
                <p class="text-muted text-center extra-small font-weight-medium mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">DEMO ACCOUNTS</p>
                <div class="row text-center extra-small">
                    <div class="col-4 px-1">
                        <div class="demo-pill">
                            <span class="text-info d-block font-weight-bold">Admin</span>
                            <code class="text-muted" style="font-size: 0.7rem;">admin</code>
                        </div>
                    </div>
                    <div class="col-4 px-1">
                        <div class="demo-pill">
                            <span class="text-primary d-block font-weight-bold">Driver</span>
                            <code class="text-muted" style="font-size: 0.7rem;">driver1</code>
                        </div>
                    </div>
                    <div class="col-4 px-1">
                        <div class="demo-pill">
                            <span class="text-success d-block font-weight-bold">Customer</span>
                            <code class="text-muted" style="font-size: 0.7rem;">customer1</code>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>