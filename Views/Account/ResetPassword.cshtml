@model KeystoneLogistics.Models.ResetPasswordModel

@{
    ViewBag.Title = "Reset Password";
}

<div class="row justify-content-center align-items-center my-4" style="min-height: 68vh;">
    <div class="col-md-6 col-lg-4">
        <div class="glass-modal-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center p-3 mb-3 rounded-circle" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);">
                    <i class="fa-solid fa-shield-halved text-success fa-lg"></i>
                </div>
                <h4 class="font-weight-bold text-white mb-1">Reset Password</h4>
                <p class="text-muted small mb-0">Set your new password below</p>
            </div>

            @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Email)
                @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.NewPassword, "New Password", new { @class = "small text-muted font-weight-medium mb-1" })
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control glass-input", placeholder = "New Password" })
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                </div>

                <div class="form-group mb-4">
                    @Html.LabelFor(m => m.ConfirmPassword, "Confirm Password", new { @class = "small text-muted font-weight-medium mb-1" })
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control glass-input", placeholder = "Confirm Password" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>

                <button type="submit" class="btn btn-block glass-btn font-weight-bold mb-3">
                    Update Password
                </button>
            }
        </div>
    </div>
</div>